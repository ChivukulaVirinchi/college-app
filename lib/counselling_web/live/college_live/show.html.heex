<Layouts.app flash={@flash}>
  <div
    class="min-h-screen bg-stone-50 dark:bg-zinc-950 transition-colors duration-200"
    phx-hook="FavoritesHook"
    id="favorites-container"
  >
    <%!-- ===== HEADER ===== --%>
    <section class="px-4 pt-8 pb-0 sm:pt-14 max-w-7xl mx-auto sm:px-6 lg:px-8">
      <.breadcrumb class="mb-6">
        <:item navigate={~p"/colleges"}>Colleges</:item>
        <:item>{@college.name}</:item>
      </.breadcrumb>

      <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4">
        <div class="min-w-0">
          <span class={[
            "inline-block text-[10px] font-bold tracking-wider uppercase px-2 py-1 rounded-full mb-3",
            type_badge_color(@college.class)
          ]}>
            {@college.class}
          </span>

          <h1 class="font-serif text-4xl sm:text-5xl lg:text-[4rem] text-stone-900 dark:text-zinc-50 tracking-tight leading-[1.08]">
            {@college.name}
          </h1>
          <div class="w-14 h-[3px] bg-amber-500 mt-5 mb-3"></div>
          <p class="text-stone-400 dark:text-zinc-500 text-lg">
            {@college.location}
          </p>
        </div>

        <%!-- Actions --%>
        <div class="flex items-center gap-2 shrink-0 sm:mt-2">
          <button
            type="button"
            id="favorite-btn-main"
            class="inline-flex items-center gap-2 px-4 py-2.5 text-[15px] font-medium rounded-lg border border-stone-300 dark:border-zinc-700 text-stone-600 dark:text-zinc-300 bg-white dark:bg-zinc-900 hover:border-amber-500 hover:text-amber-600 dark:hover:border-amber-500 dark:hover:text-amber-400 transition-colors whitespace-nowrap"
            data-id={@college.id}
            data-type="college"
            phx-hook="FavoriteButton"
            title="Add to favorites"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"
              />
            </svg>
            <span class="favorite-text">Favorite</span>
          </button>

          <button
            type="button"
            id="share-btn-main"
            class="inline-flex items-center gap-2 px-4 py-2.5 text-[15px] font-medium rounded-lg border border-stone-300 dark:border-zinc-700 text-stone-600 dark:text-zinc-300 bg-white dark:bg-zinc-900 hover:border-amber-500 hover:text-amber-600 dark:hover:border-amber-500 dark:hover:text-amber-400 transition-colors"
            phx-hook="ShareHook"
            data-title={@college.name}
            data-url={~p"/colleges/#{@college}"}
            title="Share college"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.367 2.684 3 3 0 00-5.367-2.684z"
              />
            </svg>
            Share
          </button>

          <.link
            href={@college.website}
            target="_blank"
            class="inline-flex items-center gap-2 px-4 py-2.5 text-[15px] font-medium rounded-lg bg-stone-900 dark:bg-zinc-100 text-white dark:text-zinc-900 hover:bg-stone-800 dark:hover:bg-zinc-200 transition-colors"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
              />
            </svg>
            Website
          </.link>
        </div>
      </div>
    </section>

    <%!-- ===== CAMPUS IMAGE ===== --%>
    <section class="px-4 pt-8 pb-2 max-w-7xl mx-auto sm:px-6 lg:px-8">
      <div class="relative overflow-hidden rounded-xl sm:rounded-2xl">
        <img
          class="w-full h-48 sm:h-64 lg:h-80 object-cover"
          src={"/#{@college.photo_path}"}
          alt={"#{@college.name} campus"}
          loading="lazy"
        />
      </div>
    </section>

    <%!-- ===== STATS STRIP ===== --%>
    <section class="px-4 py-8 sm:py-10 max-w-7xl mx-auto sm:px-6 lg:px-8">
      <div class="grid grid-cols-3 gap-6 sm:gap-8">
        <div>
          <div class="font-serif text-3xl sm:text-4xl text-stone-900 dark:text-zinc-100">
            <%= if nirf_current = Enum.find(@college.nirf_rankings, fn r -> r.year == @latest_year end) do %>
              {nirf_helper(nirf_current.nirf_rank)}
            <% else %>
              &mdash;
            <% end %>
          </div>
          <div class="mt-1.5 flex items-center gap-1.5 text-xs uppercase tracking-[0.15em] text-stone-400 dark:text-zinc-500 font-medium">
            NIRF {@latest_year}
            <%= if nirf_current = Enum.find(@college.nirf_rankings, fn r -> r.year == @latest_year end) do %>
              <%= if nirf_band?(nirf_current.nirf_rank) do %>
                <span
                  class="normal-case tracking-normal inline-flex items-center rounded-full bg-amber-50 dark:bg-amber-950/40 px-1.5 py-0.5 text-[10px] font-medium text-amber-700 dark:text-amber-400 ring-1 ring-inset ring-amber-200 dark:ring-amber-800/50 cursor-help"
                  title="NIRF publishes exact ranks for the top 100. Colleges ranked 101+ are placed in bands (e.g. 101–150, 151–200, 201–300)."
                >
                  Rank band
                </span>
              <% end %>
            <% end %>
          </div>
        </div>
        <div>
          <div class="font-serif text-3xl sm:text-4xl text-stone-900 dark:text-zinc-100">
            {@college.established_year}
          </div>
          <div class="mt-1.5 text-xs uppercase tracking-[0.15em] text-stone-400 dark:text-zinc-500 font-medium">
            Established
          </div>
        </div>
        <div>
          <div class="font-serif text-3xl sm:text-4xl text-stone-900 dark:text-zinc-100">
            {@college.campus_area}
          </div>
          <div class="mt-1.5 text-xs uppercase tracking-[0.15em] text-stone-400 dark:text-zinc-500 font-medium">
            Acres
          </div>
        </div>
      </div>
    </section>

    <%!-- Divider --%>
    <div class="flex items-center gap-4 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex-1 h-px bg-stone-200 dark:bg-zinc-800"></div>
      <div class="w-1.5 h-1.5 rounded-full bg-amber-500"></div>
      <div class="flex-1 h-px bg-stone-200 dark:bg-zinc-800"></div>
    </div>

    <%!-- ===== ABOUT ===== --%>
    <section class="px-4 py-10 sm:py-14 max-w-7xl mx-auto sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <div class="w-10 h-1 bg-amber-500 rounded-full mb-5"></div>
        <h2 class="font-serif text-2xl sm:text-3xl text-stone-900 dark:text-zinc-50 mb-4">
          About
        </h2>
        <p class="text-base sm:text-lg text-stone-500 dark:text-zinc-400 leading-relaxed">
          {@college.description}
        </p>
      </div>
    </section>

    <%!-- ===== NIRF RANKINGS HISTORY ===== --%>
    <%= if @college.nirf_rankings != [] do %>
      <section class="px-4 pb-10 sm:pb-14 max-w-7xl mx-auto sm:px-6 lg:px-8">
        <div class="w-10 h-1 bg-amber-500 rounded-full mb-5"></div>
        <div class="flex items-baseline justify-between mb-6">
          <div>
            <h2 class="font-serif text-2xl sm:text-3xl text-stone-900 dark:text-zinc-50">
              NIRF Rankings
            </h2>
            <p class="text-sm text-stone-400 dark:text-zinc-500 mt-1">
              National Institutional Ranking Framework &middot; * denotes rank band
            </p>
          </div>
        </div>

        <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-6 lg:grid-cols-8 gap-3">
          <div
            :for={year <- 2023..@latest_year}
            class="text-center"
          >
            <% ranking = Enum.find(@college.nirf_rankings, fn r -> r.year == year end) %>
            <div class="text-xs uppercase tracking-wider text-stone-400 dark:text-zinc-500 mb-2 font-medium">
              {year}
            </div>
            <%= if ranking do %>
              <div class="font-serif text-2xl sm:text-3xl text-stone-900 dark:text-zinc-100">
                {nirf_helper(ranking.nirf_rank)}
              </div>
            <% else %>
              <div class="text-lg text-stone-300 dark:text-zinc-700">&mdash;</div>
            <% end %>
          </div>
        </div>

        <%!-- Chart --%>
        <div class="mt-8 border border-stone-200 dark:border-zinc-800 rounded-xl p-4 sm:p-6 bg-white dark:bg-zinc-900">
          <div class="relative h-48 sm:h-64">
            <canvas
              id="rankingsChart"
              class="w-full h-full"
              phx-hook="ChartsHook"
              data-rankings={
                Jason.encode!(
                  Enum.map(@college.nirf_rankings, fn r ->
                    %{year: r.year, rank: r.nirf_rank}
                  end)
                )
              }
            >
            </canvas>
          </div>
        </div>
      </section>
    <% end %>

    <%!-- Divider --%>
    <div class="flex items-center gap-4 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex-1 h-px bg-stone-200 dark:bg-zinc-800"></div>
      <div class="w-1.5 h-1.5 rounded-full bg-amber-500"></div>
      <div class="flex-1 h-px bg-stone-200 dark:bg-zinc-800"></div>
    </div>

    <%!-- ===== PROGRAMS & CUTOFFS ===== --%>
    <section class="px-4 py-10 sm:py-14 max-w-7xl mx-auto sm:px-6 lg:px-8">
      <div class="flex items-baseline justify-between mb-6">
        <div>
          <div class="w-10 h-1 bg-amber-500 rounded-full mb-5"></div>
          <h2 class="font-serif text-2xl sm:text-3xl text-stone-900 dark:text-zinc-50">
            Programs &amp; Cutoffs
          </h2>
          <p class="text-sm text-stone-400 dark:text-zinc-500 mt-1">
            {@latest_year} JoSAA closing ranks &middot; Filter by category, quota, gender
          </p>
        </div>
        <.link
          navigate={~p"/programs"}
          class="text-[15px] font-medium text-amber-600 dark:text-amber-400 hover:text-amber-700 dark:hover:text-amber-300 transition-colors hidden sm:inline"
        >
          All Programs &rarr;
        </.link>
      </div>

      <.help_pill id="help-college-cutoffs" class="mb-4">
        <strong>Tip:</strong>
        Closing rank is the last rank that got admission. A lower number = harder to get in.
        Use the category filter to see cutoffs for OPEN, OBC-NCL, SC, ST, or EWS.
        Click any program row to see its full historical trends.
      </.help_pill>

      <div id="category-filter-hook" phx-hook="CategoryFilterHook" class="hidden"></div>
      <div class="border border-stone-200 dark:border-zinc-800 rounded-xl overflow-hidden bg-white dark:bg-zinc-900">
        <.live_table
          fields={fields()}
          filters={filters_for(@college.class)}
          options={@options}
          streams={@streams}
          class="min-w-full"
        />
      </div>
    </section>

    <%!-- ===== SIMILAR COLLEGES ===== --%>
    <%= if @similar_colleges != [] do %>
      <section class="px-4 pb-16 max-w-7xl mx-auto sm:px-6 lg:px-8">
        <div class="w-10 h-1 bg-amber-500 rounded-full mb-5"></div>
        <h2 class="font-serif text-2xl sm:text-3xl text-stone-900 dark:text-zinc-50 mb-6">
          Similar Colleges
        </h2>

        <div class="grid gap-4 sm:grid-cols-3">
          <.link
            :for={%{college: c, rank: rank} <- @similar_colleges}
            navigate={~p"/colleges/#{c}"}
            class="group flex items-center justify-between p-5 border border-stone-200 dark:border-zinc-800 rounded-xl bg-white dark:bg-zinc-900 hover:border-amber-500/50 dark:hover:border-amber-500/30 transition-colors"
          >
            <div class="min-w-0">
              <div class="text-[15px] font-medium text-stone-900 dark:text-zinc-100 group-hover:text-amber-600 dark:group-hover:text-amber-400 transition-colors truncate">
                {c.name}
              </div>
              <div class="text-sm text-stone-400 dark:text-zinc-500 mt-0.5">
                {c.location}
              </div>
            </div>
            <div class="shrink-0 ml-4 text-right">
              <div class="font-serif text-xl text-stone-900 dark:text-zinc-100">
                {nirf_helper(rank)}
              </div>
              <div class="text-[11px] uppercase tracking-wider text-stone-400 dark:text-zinc-500">
                NIRF
              </div>
            </div>
          </.link>
        </div>
      </section>
    <% end %>
  </div>
</Layouts.app>
