leges -->\n        <div class=\"p-4 bg-white dark:bg-gray-800 shadow-md border border-gray-100 dark:border-gray-700 rounded-lg sm:p-6 sm:shadow-lg sm:rounded-2xl\">\n          <h3 class=\"mb-3 text-base font-semibold text-gray-900 dark:text-white sm:mb-4 sm:text-lg\">Similar Colleges</h3>\n          <div class=\"space-y-2 sm:space-y-3\">\n            <div class=\"p-3 border border-gray-200 dark:border-gray-600 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 cursor-pointer transition-colors\">\n              <div class=\"text-sm font-medium text-gray-900 dark:text-white\">IIT Bombay</div>\n              <div class=\"text-xs text-gray-600 dark:text-gray-400\">Mumbai • NIRF Rank: 3</div>\n            </div>\n            <div class=\"p-3 border border-gray-200 dark:border-gray-600 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 cursor-pointer transition-colors\">\n              <div class=\"text-sm font-medium text-gray-900 dark:text-white\">IIT Madras</div>\n              <div class=\"text-xs text-gray-600 dark:text-gray-400\">Chennai • NIRF Rank: 1</div>\n            </div>\n            <div class=\"p-3 border border-gray-200 dark:border-gray-600 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 cursor-pointer transition-colors\">\n              <div class=\"text-sm font-medium text-gray-900 dark:text-white\">IIT Kanpur</div>\n              <div class=\"text-xs text-gray-600 dark:text-gray-400\">Kanpur • NIRF Rank: 4</div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</div>\n\n<!-- Chart.js Script -->\n<script src=\"https://cdn.jsdelivr.net/npm/chart.js\"></script>\n<script>\n  document.addEventListener('DOMContentLoaded', function() {\n    const ctx = document.getElementById('rankingsChart');\n    if (ctx && '<%= @college.nirf_rankings != [] %>') {\n      const rankings = <%= if @college.nirf_rankings != [], do: Jason.encode!(Enum.map(@college.nirf_rankings, fn r -> %{year: r.year, rank: r.nirf_rank} end)), else: \"[]\" %>;\n      \n      if (rankings.length > 0) {\n        const years = rankings.map(r => r.year).sort();\n        const ranks = years.map(year => {\n          const ranking = rankings.find(r => r.year === year);\n          return ranking ? ranking.rank : null;\n        });\n\n        // Check if dark mode is enabled\n        const isDarkMode = document.documentElement.classList.contains('dark') || \n                          window.matchMedia('(prefers-color-scheme: dark)').matches;\n\n        const gridColor = isDarkMode ? 'rgba(156, 163, 175, 0.2)' : 'rgba(0, 0, 0, 0.1)';\n        const textColor = isDarkMode ? 'rgb(156, 163, 175)' : 'rgb(75, 85, 99)';\n\n        new Chart(ctx, {\n          type: 'line',\n          data: {\n            labels: years,\n            datasets: [{\n              label: 'NIRF Ranking',\n              data: ranks,\n              borderColor: 'rgb(139, 92, 246)',\n              backgroundColor: 'rgba(139, 92, 246, 0.1)',\n              borderWidth: 3,\n              fill: true,\n              tension: 0.4,\n              pointBackgroundColor: 'rgb(139, 92, 246)',\n              pointBorderColor: '#fff',\n              pointBorderWidth: 2,\n              pointRadius: 4,\n              pointHoverRadius: 6\n            }]\n          },\n          options: {\n            responsive: true,\n            maintainAspectRatio: false,\n            plugins: {\n              legend: {\n                display: false\n              }\n            },\n            scales: {\n              y: {\n                reverse: true,\n                beginAtZero: false,\n                title: {\n                  display: true,\n                  text: 'Rank (Lower is Better)',\n                  color: textColor,\n                  font: {\n                    size: 11\n                  }\n                },\n                grid: {\n                  color: gridColor\n                },\n                ticks: {\n                  color: textColor,\n                  font: {\n                    size: 10\n                  }\n                }\n              },\n              x: {\n                title: {\n                  display: true,\n                  text: 'Year',\n                  color: textColor,\n                  font: {\n                    size: 11\n                  }\n                },\n                grid: {\n                  color: gridColor\n                },\n                ticks: {\n                  color: textColor,\n                  font: {\n                    size: 10\n                  }\n                }\n              }\n            }\n          }\n        });\n      }\n    }\n  });\n\n  // Update chart colors when theme changes\n  const observer = new MutationObserver(function(mutations) {\n    mutations.forEach(function(mutation) {\n      if (mutation.attributeName === 'class') {\n        const chartInstance = Chart.getChart('rankingsChart');\n        if (chartInstance) {\n          const isDarkMode = document.documentElement.classList.contains('dark');\n          const gridColor = isDarkMode ? 'rgba(156, 163, 175, 0.2)' : 'rgba(0, 0, 0, 0.1)';\n          const textColor = isDarkMode ? 'rgb(156, 163, 175)' : 'rgb(75, 85, 99)';\n          \n          chartInstance.options.scales.y.grid.color = gridColor;\n          chartInstance.options.scales.x.grid.color = gridColor;\n          chartInstance.options.scales.y.ticks.color = textColor;\n          chartInstance.options.scales.x.ticks.color = textColor;\n          chartInstance.options.scales.y.title.color = textColor;\n          chartInstance.options.scales.x.title.color = textColor;\n          chartInstance.update();\n        }\n      }\n    });\n  });\n\n  observer.observe(document.documentElement, {\n    attributes: true,\n    attributeFilter: ['class']\n  });\n</script>",
