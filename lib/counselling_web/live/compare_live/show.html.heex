<Layouts.app flash={@flash}>
  <div
    class={[
      "bg-stone-50 dark:bg-zinc-950 transition-colors duration-200",
      if(@colleges == [],
        do: "h-[calc(100dvh-4rem)] overflow-hidden flex flex-col",
        else: "min-h-screen"
      )
    ]}
    id="compare-page"
    phx-hook="CmdKHook"
  >
    <%!-- ===== HEADER ===== --%>
    <section class="px-4 pt-8 pb-2 sm:pt-14 sm:pb-4 max-w-[90rem] mx-auto sm:px-6 lg:px-8">
      <.breadcrumb class="mb-6">
        <:item navigate={~p"/colleges"}>Colleges</:item>
        <:item>Compare</:item>
      </.breadcrumb>

      <h1 class="font-serif text-5xl sm:text-6xl lg:text-[5rem] text-stone-900 dark:text-zinc-50 tracking-tight leading-none">
        Compare
      </h1>
      <div class="w-16 h-[3px] bg-amber-500 mt-5 mb-2"></div>
      <p class="text-stone-400 dark:text-zinc-500 text-lg sm:text-xl">
        Side-by-side analysis of up to 4 colleges
      </p>
    </section>

    <%!-- ===== CONTROLS ===== --%>
    <section class="px-4 pt-4 pb-6 max-w-[90rem] mx-auto sm:px-6 lg:px-8 space-y-3">
      <.help_pill id="help-compare-page" class="">
        <strong>Tip:</strong>
        Add up to 4 colleges to compare side by side. Use
        <kbd class="inline-flex items-center gap-0.5 px-1 py-0.5 text-[10px] font-mono bg-blue-100 dark:bg-blue-800/30 rounded">
          <span class="text-[9px]">&#8984;</span>K
        </kbd>
        to quickly search. Change the category to compare cutoffs for your reservation group.
      </.help_pill>

      <%!-- Line 1: Command trigger (full-width-ish search bar) --%>
      <button
        type="button"
        phx-click={show_dialog("college-search-dialog")}
        disabled={length(@selected_college_ids) >= @max_colleges}
        class={[
          "w-full sm:w-auto sm:min-w-[28rem] flex items-center gap-3 px-4 py-2.5 rounded-lg border text-[15px] transition-all",
          if(length(@selected_college_ids) >= @max_colleges,
            do:
              "border-stone-200 dark:border-zinc-800 text-stone-300 dark:text-zinc-600 cursor-not-allowed",
            else:
              "border-stone-300 dark:border-zinc-700 text-stone-400 dark:text-zinc-500 hover:border-amber-500 hover:text-amber-600 dark:hover:border-amber-500 dark:hover:text-amber-400 bg-white dark:bg-zinc-900"
          )
        ]}
      >
        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
          />
        </svg>
        <span class="flex-1 text-left">Search colleges to compare&hellip;</span>
        <kbd class="hidden sm:inline-flex items-center gap-1 px-1.5 py-0.5 text-[11px] font-mono text-stone-400 dark:text-zinc-600 bg-stone-100 dark:bg-zinc-800 rounded">
          <span class="text-[10px]">&#8984;</span>K
        </kbd>
        <span class="text-xs tabular-nums text-stone-300 dark:text-zinc-600">
          {length(@selected_college_ids)}/{@max_colleges}
        </span>
      </button>

      <%!-- Line 2: Tags + clear all (left) — category selector (right) --%>
      <div :if={@colleges != []} class="flex items-start justify-between gap-4">
        <div class="flex flex-wrap items-center gap-2 min-w-0">
          <div
            :for={college <- @colleges}
            class="inline-flex items-center gap-1.5 pl-3 pr-1.5 py-1.5 bg-stone-200/70 dark:bg-zinc-800 text-stone-700 dark:text-zinc-300 rounded-full"
          >
            <span class="text-[15px] font-medium truncate max-w-[200px]">{college.name}</span>
            <button
              type="button"
              phx-click="remove_college"
              phx-value-college_id={college.id}
              class="p-0.5 rounded-full hover:bg-stone-300 dark:hover:bg-zinc-700 transition-colors"
              title={"Remove #{college.name}"}
            >
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M6 18L18 6M6 6l12 12"
                />
              </svg>
            </button>
          </div>

          <button
            :if={length(@selected_college_ids) > 1}
            type="button"
            phx-click="clear_all"
            class="text-sm text-stone-400 dark:text-zinc-500 hover:text-red-500 dark:hover:text-red-400 transition-colors"
          >
            Clear all
          </button>
        </div>

        <div
          id="compare-category-wrapper"
          phx-update="ignore"
          phx-hook="CompareCategoryHook"
          data-current-seat-type={Atom.to_string(@seat_type)}
          data-has-seat-type-param={@has_seat_type_param}
          class="flex items-center gap-2 shrink-0"
        >
          <span class="text-xs uppercase tracking-[0.15em] text-stone-400 dark:text-zinc-500 font-medium hidden sm:inline">
            Category
          </span>
          <.select
            id="compare-category-select"
            name="seat_type"
            value={Atom.to_string(@seat_type)}
          >
            <.select_option value="open" label="OPEN" />
            <.select_option value="obc_ncl" label="OBC-NCL" />
            <.select_option value="sc" label="SC" />
            <.select_option value="st" label="ST" />
            <.select_option value="ews" label="EWS" />
            <.select_option value="open_pwd" label="OPEN (PwD)" />
            <.select_option value="obc_ncl_pwd" label="OBC-NCL (PwD)" />
            <.select_option value="sc_pwd" label="SC (PwD)" />
            <.select_option value="st_pwd" label="ST (PwD)" />
            <.select_option value="ews_pwd" label="EWS (PwD)" />
          </.select>
        </div>
      </div>
    </section>

    <%!-- ===== COMPARISON TABLE ===== --%>
    <section :if={@colleges != []} class="px-4 pb-16 max-w-[90rem] mx-auto sm:px-6 lg:px-8">
      <div class="border border-stone-200 dark:border-zinc-800 rounded-xl overflow-hidden bg-white dark:bg-zinc-900">
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead>
              <tr class="border-b border-stone-200 dark:border-zinc-800">
                <th class="px-5 py-4 text-left text-xs font-semibold uppercase tracking-wider text-stone-400 dark:text-zinc-500 w-44 bg-stone-50/50 dark:bg-zinc-900/50">
                </th>
                <th
                  :for={college <- @colleges}
                  class="px-5 py-4 text-center min-w-[14rem]"
                >
                  <div class="font-serif text-lg text-stone-900 dark:text-zinc-100">
                    {college.name}
                  </div>
                </th>
              </tr>
            </thead>
            <tbody>
              <%!-- Campus image --%>
              <tr class="border-b border-stone-100 dark:border-zinc-800/60">
                <td class="px-5 py-3 text-[15px] font-medium text-stone-500 dark:text-zinc-400 bg-stone-50/50 dark:bg-zinc-900/50">
                  Campus
                </td>
                <td :for={college <- @colleges} class="px-5 py-3">
                  <img
                    class="w-full h-28 object-cover rounded-lg"
                    src={"/#{college.photo_path}"}
                    alt={college.name}
                    loading="lazy"
                  />
                </td>
              </tr>

              <%!-- Section: Basics --%>
              <tr>
                <td
                  class="px-5 py-2.5 text-[11px] font-bold uppercase tracking-[0.2em] text-amber-600 dark:text-amber-400 bg-stone-50/50 dark:bg-zinc-900/50"
                  colspan={length(@colleges) + 1}
                >
                  Basic Information
                </td>
              </tr>

              <tr class="border-b border-stone-100 dark:border-zinc-800/60">
                <td class="px-5 py-3.5 text-[15px] text-stone-500 dark:text-zinc-400 bg-stone-50/50 dark:bg-zinc-900/50">
                  Location
                </td>
                <td
                  :for={college <- @colleges}
                  class="px-5 py-3.5 text-[15px] text-center text-stone-700 dark:text-zinc-300"
                >
                  {college.location}
                </td>
              </tr>

              <tr class="border-b border-stone-100 dark:border-zinc-800/60">
                <td class="px-5 py-3.5 text-[15px] text-stone-500 dark:text-zinc-400 bg-stone-50/50 dark:bg-zinc-900/50">
                  Established
                </td>
                <td
                  :for={college <- @colleges}
                  class="px-5 py-3.5 text-[15px] text-center text-stone-700 dark:text-zinc-300"
                >
                  {college.established_year}
                </td>
              </tr>

              <tr class="border-b border-stone-100 dark:border-zinc-800/60">
                <td class="px-5 py-3.5 text-[15px] text-stone-500 dark:text-zinc-400 bg-stone-50/50 dark:bg-zinc-900/50">
                  Type
                </td>
                <td :for={college <- @colleges} class="px-5 py-3.5 text-center">
                  <span class={[
                    "inline-flex items-center px-2.5 py-1 text-xs font-bold uppercase tracking-wider rounded-full",
                    type_color(college.class)
                  ]}>
                    {format_college_class(college.class)}
                  </span>
                </td>
              </tr>

              <tr class="border-b border-stone-100 dark:border-zinc-800/60">
                <td class="px-5 py-3.5 text-[15px] text-stone-500 dark:text-zinc-400 bg-stone-50/50 dark:bg-zinc-900/50">
                  Campus Area
                </td>
                <td
                  :for={college <- @colleges}
                  class="px-5 py-3.5 text-[15px] text-center font-medium text-stone-700 dark:text-zinc-200"
                >
                  {college.campus_area} acres
                </td>
              </tr>

              <%!-- Section: Rankings --%>
              <tr>
                <td
                  class="px-5 py-2.5 text-[11px] font-bold uppercase tracking-[0.2em] text-amber-600 dark:text-amber-400 bg-stone-50/50 dark:bg-zinc-900/50"
                  colspan={length(@colleges) + 1}
                >
                  Rankings
                </td>
              </tr>

              <tr class="border-b border-stone-100 dark:border-zinc-800/60">
                <td class="px-5 py-3.5 text-[15px] text-stone-500 dark:text-zinc-400 bg-stone-50/50 dark:bg-zinc-900/50">
                  NIRF {@latest_year}
                </td>
                <td :for={college <- @colleges} class="px-5 py-3.5 text-center">
                  <% rank = get_nirf_rank(college) %>
                  <%= if rank do %>
                    <span class="font-serif text-2xl font-medium text-stone-900 dark:text-zinc-100">
                      {rank |> nirf_helper()}
                    </span>
                  <% else %>
                    <span class="text-stone-300 dark:text-zinc-600">&mdash;</span>
                  <% end %>
                </td>
              </tr>

              <%!-- Section: Program Cutoffs --%>
              <%= if length(@colleges) >= 2 and @common_programs != [] do %>
                <tr>
                  <td
                    class="px-5 py-2.5 text-[11px] font-bold uppercase tracking-[0.2em] text-amber-600 dark:text-amber-400 bg-stone-50/50 dark:bg-zinc-900/50"
                    colspan={length(@colleges) + 1}
                  >
                    Cutoffs &mdash; {@seat_type_label}, {@latest_year}
                  </td>
                </tr>

                <tr
                  :for={program <- @common_programs}
                  class="border-b border-stone-100 dark:border-zinc-800/60"
                >
                  <td class="px-5 py-3.5 text-[15px] font-medium text-stone-700 dark:text-zinc-200 bg-stone-50/50 dark:bg-zinc-900/50">
                    {program.name}
                  </td>
                  <td :for={college <- @colleges} class="px-5 py-3.5 text-center">
                    <% cutoff = Map.get(@cutoff_map, {college.id, program.id}) %>
                    <%= if cutoff do %>
                      <span class="text-[15px] tabular-nums text-stone-700 dark:text-zinc-200">
                        <RankComponent.rank_display
                          class="text-[15px]"
                          rank={cutoff.opening_rank}
                        />
                        <span class="text-stone-300 dark:text-zinc-600 mx-0.5">&ndash;</span>
                        <RankComponent.rank_display
                          class="text-[15px]"
                          rank={cutoff.closing_rank}
                        />
                      </span>
                    <% else %>
                      <span class="text-stone-300 dark:text-zinc-600">&mdash;</span>
                    <% end %>
                  </td>
                </tr>
              <% end %>

              <%!-- Section: Actions --%>
              <tr>
                <td
                  class="px-5 py-2.5 text-[11px] font-bold uppercase tracking-[0.2em] text-amber-600 dark:text-amber-400 bg-stone-50/50 dark:bg-zinc-900/50"
                  colspan={length(@colleges) + 1}
                >
                  Actions
                </td>
              </tr>

              <tr class="border-b border-stone-100 dark:border-zinc-800/60">
                <td class="px-5 py-3.5 text-[15px] text-stone-500 dark:text-zinc-400 bg-stone-50/50 dark:bg-zinc-900/50">
                  View Details
                </td>
                <td :for={college <- @colleges} class="px-5 py-3.5 text-center">
                  <.link
                    navigate={~p"/colleges/#{college}"}
                    class="text-[15px] font-medium text-amber-600 dark:text-amber-400 hover:text-amber-700 dark:hover:text-amber-300 transition-colors"
                  >
                    View &rarr;
                  </.link>
                </td>
              </tr>

              <tr>
                <td class="px-5 py-3.5 text-[15px] text-stone-500 dark:text-zinc-400 bg-stone-50/50 dark:bg-zinc-900/50">
                  Remove
                </td>
                <td :for={college <- @colleges} class="px-5 py-3.5 text-center">
                  <button
                    type="button"
                    phx-click="remove_college"
                    phx-value-college_id={college.id}
                    class="text-[15px] text-stone-400 dark:text-zinc-500 hover:text-red-500 dark:hover:text-red-400 transition-colors"
                  >
                    Remove
                  </button>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <%!-- ===== EMPTY STATE ===== --%>
    <section
      :if={@colleges == []}
      class="flex-1 flex flex-col items-center justify-center"
    >
      <div class="w-16 h-16 rounded-full bg-stone-100 dark:bg-zinc-800 flex items-center justify-center mb-6">
        <svg
          class="w-7 h-7 text-stone-300 dark:text-zinc-600"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.5"
            d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"
          />
        </svg>
      </div>
      <p class="font-serif text-2xl sm:text-3xl text-stone-900 dark:text-zinc-100 mb-2">
        No colleges yet
      </p>
      <p class="text-stone-400 dark:text-zinc-500 mb-8">
        Add colleges to start comparing
      </p>
      <button
        type="button"
        phx-click={show_dialog("college-search-dialog")}
        class="inline-flex items-center gap-2 px-5 py-3 rounded-lg bg-stone-900 dark:bg-zinc-100 text-white dark:text-zinc-900 text-[15px] font-medium hover:bg-stone-800 dark:hover:bg-zinc-200 transition-colors"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
          />
        </svg>
        Search &amp; add colleges
      </button>
    </section>

    <%!-- ===== SEARCH DIALOG ===== --%>
    <.dialog id="college-search-dialog" class="sm:max-w-xl">
      <.command
        id="college-search-command"
        placeholder="Search colleges by name, location, or type..."
        empty_text="No colleges found."
      >
        <.command_group heading="Colleges">
          <.command_item
            :for={college <- @all_colleges}
            id={"college-cmd-#{college.id}"}
            keywords={[
              college.location,
              to_string(college.class),
              format_college_class(college.class)
            ]}
            disabled={college.id in @selected_college_ids}
            phx-click={
              JS.push("add_college", value: %{id: college.id})
              |> hide_dialog("college-search-dialog")
            }
          >
            <div class="flex items-center justify-between w-full">
              <div>
                <div class="text-[15px] font-medium text-stone-900 dark:text-zinc-100">
                  {college.name}
                </div>
                <div class="text-xs text-stone-400 dark:text-zinc-500 leading-tight">
                  {college.location}
                </div>
              </div>
              <div class="flex items-center gap-2 shrink-0 ml-4">
                <span
                  :if={college.nirf_rank}
                  class="text-xs tabular-nums text-stone-400 dark:text-zinc-500"
                >
                  #{college.nirf_rank |> nirf_helper()}
                </span>
                <span class={[
                  "text-[10px] font-bold tracking-wider uppercase px-1.5 py-0.5 rounded",
                  type_color_subtle(college.class)
                ]}>
                  {format_college_class(college.class)}
                </span>
              </div>
            </div>
          </.command_item>
        </.command_group>
      </.command>
    </.dialog>

    <%!-- CompareStorageHook for localStorage sync --%>
    <div phx-hook="CompareStorageHook" id="compare-live-storage-hook" class="hidden" />
  </div>
</Layouts.app>
