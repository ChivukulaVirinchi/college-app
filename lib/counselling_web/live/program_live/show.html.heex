<section class="px-4 mx-auto max-w-7xl sm:px-6 md:px-8">
  <%= @program.name %>
  <%= (@program.duration |> to_string()) <> " Years" %>
  <%= @program.degree_type %>
  <br />
  <.link patch={~p"/programs"}>Back</.link>
  <br />
  <.link patch={~p"/colleges"}>Colleges</.link>

  <%= @filters[:class] %>

  <form phx-change="filter">
    <%= for class <- [:IIT, :NIT, :IIIT, :GFTI] do %>
      <label class="inline-flex items-center text-sm text-gray-500 ms-3 ark:text-neutral-400">
        <input
          type="checkbox"
          name="class[]"
          value={class}
          checked={Atom.to_string(class) in @filters[:class]}
          class="shrink-0 mt-0.5 border-gray-400/50 rounded text-violet-600 focus:ring-blue-50 disabled:opacity-50 disabled:pointer-events-none ark:bg-neutral-800 ark:border-neutral-700 ark:checked:bg-blue-500 ark:checked:border-blue-500 ark:focus:ring-offset-gray-800"
        />
        <span class="ml-2"><%= class %></span>
      </label>
    <% end %>
    <%= for category <- [:gender_neutral, :female] do %>
      <label class="inline-flex items-center text-sm text-gray-500 ms-3 ark:text-neutral-400">
        <input
          type="checkbox"
          name="category[]"
          value={category}
          checked={Atom.to_string(category) in @filters[:category]}
          class="shrink-0 mt-0.5 border-gray-400/50 rounded text-violet-600 focus:ring-blue-50 disabled:opacity-50 disabled:pointer-events-none ark:bg-neutral-800 ark:border-neutral-700 ark:checked:bg-blue-500 ark:checked:border-blue-500 ark:focus:ring-offset-gray-800"
        />
        <span class="ml-2"><%= process_category(category) %></span>
      </label>
    <% end %>
  </form>
  <div class="flex flex-col">
    <div class="-m-1.5 overflow-x-auto">
      <div class="p-1.5 min-w-full inline-block align-middle">
        <div class="overflow-hidden ">
          <table class="min-w-full border border-gray-200 divide-y divide-gray-200 rounded-3xl ark:divide-neutral-700">
            <thead>
              <tr>
                <th
                  scope="col"
                  class="px-6 py-3 text-xs font-medium text-gray-500 uppercase text-start ark:text-neutral-500"
                >
                  <.link
                    phx-click="filter"
                    phx-value-sort_by="name"
                    phx-value-sort_order={get_sort_order(@filters[:sort_order])}
                  >
                    Name
                    <.icon
                      :if={@filters.sort_by == "name"}
                      name={
                        if @filters.sort_order == "asc",
                          do: "hero-arrow-up-solid",
                          else: "hero-arrow-down-solid"
                      }
                      class="w-4 h-4 text-gray-900"
                    />
                  </.link>
                </th>
                <th
                  scope="col"
                  class="px-6 py-3 text-xs font-medium text-gray-500 uppercase text-start ark:text-neutral-500"
                >
                  Location
                </th>
                <th
                  scope="col"
                  class="px-6 py-3 text-xs font-medium text-gray-500 uppercase text-start ark:text-neutral-500"
                >
                  <.link
                    phx-click="filter"
                    phx-value-sort_by="opening_rank"
                    phx-value-sort_order={get_sort_order(@filters[:sort_order])}
                  >
                    Opening Rank
                    <.icon
                      :if={@filters.sort_by == "opening_rank"}
                      name={
                        if @filters.sort_order == "asc",
                          do: "hero-arrow-up-solid",
                          else: "hero-arrow-down-solid"
                      }
                      class="w-4 h-4 text-gray-900"
                    />
                  </.link>
                </th>
                <th
                  scope="col"
                  class="px-6 py-3 text-xs font-medium text-gray-500 uppercase text-start ark:text-neutral-500"
                >
                  <.link
                    phx-click="filter"
                    phx-value-sort_by="closing_rank"
                    phx-value-sort_order={get_sort_order(@filters[:sort_order])}
                  >
                    Closing Rank
                    <.icon
                      :if={@filters.sort_by == "closing_rank"}
                      name={
                        if @filters.sort_order == "asc",
                          do: "hero-arrow-up-solid",
                          else: "hero-arrow-down-solid"
                      }
                      class="w-4 h-4 text-gray-900"
                    />
                  </.link>
                </th>
                <th
                  scope="col"
                  class="px-6 py-3 text-xs font-medium text-gray-500 uppercase text-start ark:text-neutral-500"
                >
                  <.link
                    phx-click="filter"
                    phx-value-sort_by="quota"
                    phx-value-sort_order={get_sort_order(@filters[:sort_order])}
                  >
                    Name
                    <.icon
                      :if={@filters.sort_by == "quota"}
                      name={
                        if @filters.sort_order == "asc",
                          do: "hero-arrow-up-solid",
                          else: "hero-arrow-down-solid"
                      }
                      class="w-4 h-4 text-gray-900"
                    />
                  </.link>
                </th>
                <th
                  scope="col"
                  class="px-6 py-3 text-xs font-medium text-gray-500 uppercase text-start ark:text-neutral-500"
                >
                  <.link
                    phx-click="filter"
                    phx-value-sort_by="category"
                    phx-value-sort_order={get_sort_order(@filters[:sort_order])}
                  >
                    Name
                    <.icon
                      :if={@filters.sort_by == "category"}
                      name={
                        if @filters.sort_order == "asc",
                          do: "hero-arrow-up-solid",
                          else: "hero-arrow-down-solid"
                      }
                      class="w-4 h-4 text-gray-900"
                    />
                  </.link>
                </th>
                <th
                  scope="col"
                  class="px-6 py-3 text-xs font-medium text-gray-500 uppercase text-end ark:text-neutral-500"
                >
                  Action
                </th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 ark:divide-neutral-700">
              <%= for {_, college} <- @streams.colleges do %>
                <tr>
                  <td class="max-w-sm px-6 py-4 text-sm font-medium text-gray-800 ark:text-neutral-200">
                    <%= college.college.name %>
                  </td>
                  <td class="px-6 py-4 text-sm text-gray-800 whitespace-nowrap ark:text-neutral-200">
                    <%= college.college.location %>
                  </td>
                  <td class="px-6 py-4 text-sm text-gray-800 whitespace-nowrap ark:text-neutral-200">
                    <span class={"px-2.5 py-0.5 rounded-full #{get_rank_color(college.closing_rank, @advanced_rank, @mains_rank, college.college.class)}"}>
                      <%= college.opening_rank %>
                    </span>
                  </td>
                  <td class="px-6 py-4 text-sm text-gray-800 whitespace-nowrap ark:text-neutral-200">
                    <span class={"px-2.5 py-0.5 rounded-full #{get_rank_color(college.closing_rank, @advanced_rank, @mains_rank, college.college.class)}"}>
                      <%= college.closing_rank %>
                    </span>
                  </td>
                  <td class="px-6 py-4 text-sm text-gray-800 whitespace-nowrap ark:text-neutral-200">
                    <%= process_quota(college.quota) %>
                  </td>
                  <td class="px-6 py-4 text-sm text-gray-800 whitespace-nowrap ark:text-neutral-200">
                    <%= process_category(college.category) %>
                  </td>
                  <td class="px-6 py-4 text-sm font-medium whitespace-nowrap text-end">
                    <.link
                      patch={~p"/colleges/#{college.college}/#{@program}"}
                      class="inline-flex items-center text-sm font-semibold text-blue-600 border border-transparent rounded-lg gap-x-2 hover:text-blue-800 focus:outline-none focus:text-blue-800 disabled:opacity-50 disabled:pointer-events-none ark:text-blue-500 ark:hover:text-blue-400 ark:focus:text-blue-400"
                    >
                      View College
                    </.link>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</section>
