<Layouts.app flash={@flash}>
  <div
    class="min-h-screen bg-stone-50 dark:bg-zinc-950 transition-colors duration-200"
    phx-hook="FavoritesHook"
    id="favorites-container"
  >
    <%!-- ===== HEADER ===== --%>
    <section class="px-4 pt-8 pb-0 sm:pt-14 max-w-7xl mx-auto sm:px-6 lg:px-8">
      <.breadcrumb class="mb-6">
        <:item navigate={~p"/programs"}>Programs</:item>
        <:item>{@program.name}</:item>
      </.breadcrumb>

      <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4">
        <div class="min-w-0">
          <span class="inline-block text-[10px] font-bold tracking-wider uppercase px-2 py-1 rounded-full bg-amber-100 text-amber-700 dark:bg-amber-500/15 dark:text-amber-400 mb-3">
            {@program.degree_type} &middot; {@program.duration} Years
          </span>

          <h1 class="font-serif text-4xl sm:text-5xl lg:text-[4rem] text-stone-900 dark:text-zinc-50 tracking-tight leading-[1.08]">
            {@program.name}
          </h1>
          <div class="w-14 h-[3px] bg-amber-500 mt-5 mb-3"></div>
          <p class="text-stone-400 dark:text-zinc-500 text-lg">
            Find the best colleges offering this program for your JEE rank
          </p>
        </div>

        <%!-- Actions --%>
        <div class="flex items-center gap-2 shrink-0 sm:mt-2">
          <button
            type="button"
            id="favorite-btn-program"
            class="inline-flex items-center gap-2 px-4 py-2.5 text-[15px] font-medium rounded-lg border border-stone-300 dark:border-zinc-700 text-stone-600 dark:text-zinc-300 bg-white dark:bg-zinc-900 hover:border-amber-500 hover:text-amber-600 dark:hover:border-amber-500 dark:hover:text-amber-400 transition-colors whitespace-nowrap"
            data-id={@program.id}
            data-type="program"
            phx-hook="FavoriteButton"
            title="Add to favorites"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"
              />
            </svg>
            <span class="favorite-text">Favorite</span>
          </button>

          <button
            type="button"
            id="share-btn-program"
            class="inline-flex items-center gap-2 px-4 py-2.5 text-[15px] font-medium rounded-lg border border-stone-300 dark:border-zinc-700 text-stone-600 dark:text-zinc-300 bg-white dark:bg-zinc-900 hover:border-amber-500 hover:text-amber-600 dark:hover:border-amber-500 dark:hover:text-amber-400 transition-colors"
            phx-hook="ShareHook"
            data-title={@program.name}
            data-url={~p"/programs/#{@program}"}
            title="Share program"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.367 2.684 3 3 0 00-5.367-2.684z"
              />
            </svg>
            Share
          </button>
        </div>
      </div>
    </section>

    <%!-- ===== STATS STRIP ===== --%>
    <section class="px-4 py-8 sm:py-10 max-w-7xl mx-auto sm:px-6 lg:px-8">
      <div class="grid grid-cols-3 gap-6 sm:gap-8">
        <div>
          <div class="font-serif text-3xl sm:text-4xl text-stone-900 dark:text-zinc-100">
            {@college_count}
          </div>
          <div class="mt-1.5 text-xs uppercase tracking-[0.15em] text-stone-400 dark:text-zinc-500 font-medium">
            Colleges
          </div>
        </div>
        <div>
          <div class="font-serif text-3xl sm:text-4xl text-stone-900 dark:text-zinc-100">
            {@program.duration}
          </div>
          <div class="mt-1.5 text-xs uppercase tracking-[0.15em] text-stone-400 dark:text-zinc-500 font-medium">
            Years
          </div>
        </div>
        <div>
          <div class="font-serif text-3xl sm:text-4xl text-stone-900 dark:text-zinc-100">
            {seat_type_label(@seat_type)}
          </div>
          <div class="mt-1.5 text-xs uppercase tracking-[0.15em] text-stone-400 dark:text-zinc-500 font-medium">
            Category
          </div>
        </div>
      </div>
    </section>

    <%!-- Divider --%>
    <div class="flex items-center gap-4 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex-1 h-px bg-stone-200 dark:bg-zinc-800"></div>
      <div class="w-1.5 h-1.5 rounded-full bg-amber-500"></div>
      <div class="flex-1 h-px bg-stone-200 dark:bg-zinc-800"></div>
    </div>

    <%!-- ===== COLLEGES & CUTOFFS ===== --%>
    <section class="px-4 py-10 sm:py-14 max-w-7xl mx-auto sm:px-6 lg:px-8">
      <div class="flex items-baseline justify-between mb-6">
        <div>
          <div class="w-10 h-1 bg-amber-500 rounded-full mb-5"></div>
          <h2 class="font-serif text-2xl sm:text-3xl text-stone-900 dark:text-zinc-50">
            Colleges &amp; Cutoffs
          </h2>
          <p class="text-sm text-stone-400 dark:text-zinc-500 mt-1">
            {@latest_year} JoSAA &middot; {seat_type_label(@seat_type)} &middot; Gender Neutral
          </p>
        </div>
        <.link
          navigate={~p"/colleges"}
          class="text-[15px] font-medium text-amber-600 dark:text-amber-400 hover:text-amber-700 dark:hover:text-amber-300 transition-colors hidden sm:inline"
        >
          All Colleges &rarr;
        </.link>
      </div>

      <.help_pill id="help-program-colleges" class="mb-4">
        <strong>Tip:</strong>
        Colleges offering this program, sorted by NIRF ranking. Cutoffs update automatically
        when you change your category in the header. Click a college to see detailed cutoffs.
      </.help_pill>

      <div id="program-category-sync" phx-hook="ProgramCategorySyncHook" class="hidden"></div>
      <.live_table
        fields={fields()}
        streams={@streams}
        filters={filters()}
        options={@options}
      />
    </section>
  </div>
</Layouts.app>
