<Layouts.app flash={@flash}>
  <div phx-hook="FavoritesHook" id="favorites-container">
    <section class="px-4 pt-8 pb-2 sm:pt-14 sm:pb-4 max-w-7xl mx-auto sm:px-6 lg:px-8">
      <.breadcrumb class="mb-6">
        <:item>Programs</:item>
      </.breadcrumb>

      <h1 class="font-serif text-5xl sm:text-6xl lg:text-[5rem] text-stone-900 dark:text-zinc-50 tracking-tight leading-none">
        Programs
      </h1>
      <div class="w-16 h-[3px] bg-violet-500 mt-5 mb-2"></div>
      <p class="text-stone-400 dark:text-zinc-500 text-lg">
        {@program_count}+ engineering programs across all specializations
      </p>
    </section>
    <div class="px-4 mx-auto max-w-7xl sm:px-6 lg:px-8 pb-16">
      <.help_pill id="help-programs-index" class="mb-4">
        <strong>Tip:</strong>
        Browse programs by degree type. Click any program to see which colleges offer it
        and their cutoff ranks for your category.
      </.help_pill>
      <.live_table
        fields={fields()}
        options={@options}
        streams={@streams}
        filters={filters()}
      />
    </div>
  </div>
</Layouts.app>
