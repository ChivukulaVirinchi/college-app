<Layouts.app flash={@flash}>
  <div
    class="min-h-screen bg-gray-50 dark:bg-gray-900 transition-colors duration-200"
    phx-hook="FavoritesHook"
    id="favorites-container"
  >
    <div class="relative overflow-hidden bg-gradient-to-br from-violet-600 via-purple-600 to-blue-600">
      <div class="absolute inset-0 bg-black/20"></div>
      <div class="relative px-4 py-8 mx-auto max-w-7xl sm:px-6 lg:px-8 sm:py-12 lg:py-16">
        
<!-- Navigation -->

        <div class="text-center">
          <div class="mb-3 sm:mb-4">
            <span class="inline-flex items-center px-2 py-1 text-xs font-medium text-white bg-white/10 backdrop-blur-sm border border-white/20 rounded-full sm:px-3">
              JOSAA Programs 2024
            </span>
          </div>

          <h1 class="mb-3 text-2xl font-bold tracking-tight text-white sm:mb-4 sm:text-3xl lg:text-5xl">
            Engineering Programs
          </h1>

          <p class="mb-4 text-base text-white/90 sm:mb-6 sm:text-lg lg:text-xl">
            Explore all engineering programs available through JOSAA counselling
          </p>
          <%!-- <div class="mb-4 p-3 bg-white/10 backdrop-blur-sm border border-white/20 rounded-lg text-sm text-white/80 max-w-2xl mx-auto">
            <div class="flex items-start space-x-2">
              <svg class="w-4 h-4 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              <div>
                <strong>How it works:</strong> Each program shows opening/closing ranks for different quotas. Enter your rank in filters to see which programs you're eligible for. Compare similar programs across different colleges.
              </div>
            </div>
          </div> --%>

          <div class="flex flex-wrap justify-center gap-2 sm:gap-3">
            <span class="inline-flex items-center px-2 py-1 text-xs font-medium text-white bg-white/10 backdrop-blur-sm border border-white/20 rounded-full sm:px-3 sm:text-sm">
              <svg
                class="w-3 h-3 mr-1 sm:w-4 sm:h-4 sm:mr-2"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"
                >
                </path>
              </svg>
              500+ Programs
            </span>

            <span class="inline-flex items-center px-2 py-1 text-xs font-medium text-white bg-white/10 backdrop-blur-sm border border-white/20 rounded-full sm:px-3 sm:text-sm">
              <svg
                class="w-3 h-3 mr-1 sm:w-4 sm:h-4 sm:mr-2"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"
                >
                </path>
              </svg>
              All Specializations
            </span>

            <span class="inline-flex items-center px-2 py-1 text-xs font-medium text-white bg-white/10 backdrop-blur-sm border border-white/20 rounded-full sm:px-3 sm:text-sm">
              <svg
                class="w-3 h-3 mr-1 sm:w-4 sm:h-4 sm:mr-2"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13 10V3L4 14h7v7l9-11h-7z"
                >
                </path>
              </svg>
              Real-time Filtering
            </span>
          </div>
        </div>
      </div>
    </div>
    
<!-- Main Content -->
    <div class="px-4 mx-auto max-w-7xl sm:px-6 lg:px-8">
      
<!-- Program Cards Grid -->
      <section class="my-8 lg:mb-12">
        <.live_table fields={fields()} options={@options} streams={@streams} filters={filters()} />
        <%!-- <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 sm:gap-6">

        <!-- Program Card 1 -->
        <div class="bg-white dark:bg-gray-800 shadow-md border border-gray-100 dark:border-gray-700 rounded-xl sm:rounded-2xl overflow-hidden hover:shadow-lg transition-all duration-200 group">
          <div class="p-4 sm:p-5">
              <div class="flex items-start justify-between mb-3">
                <div class="flex-1">
                  <div class="flex items-center space-x-2 mb-2">
                    <span class="inline-flex items-center px-2 py-1 text-xs font-medium text-white bg-violet-600 rounded-full">
                      Degree: B.Tech
                    </span>
                    <span class="inline-flex items-center px-2 py-1 text-xs font-medium text-violet-700 dark:text-violet-300 bg-violet-100 dark:bg-violet-900/30 rounded-full">
                      4 Years
                    </span>
                  </div>
                  <h3 class="font-bold text-gray-900 dark:text-white text-base sm:text-lg mb-1">Computer Science and Engineering</h3>
                  <p class="text-sm text-gray-600 dark:text-gray-400">
                    Popular program offered in 85 colleges
                  </p>
                </div>
                <div class="ml-2">
                  <div class="flex items-center justify-center w-8 h-8 bg-blue-100 dark:bg-blue-900/30 rounded-full">
                    <span class="text-sm font-semibold text-blue-700 dark:text-blue-300">85</span>
                  </div>
                </div>
              </div>

              <div class="flex items-center justify-between mb-4 px-3 py-2 bg-gray-50 dark:bg-gray-700/50 rounded-lg">
                <div class="flex items-center">
                  <svg class="w-4 h-4 mr-2 text-gray-500 dark:text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                  </svg>
                  <span class="text-sm text-gray-700 dark:text-gray-300">B.Tech • 4 Years</span>
                </div>
                <div class="flex items-center">
                  <span class="text-xs text-gray-500 dark:text-gray-400">Available at IITs, NITs, GFTIs, IIITs</span>
                </div>
              </div>

            <div class="flex space-x-2">
              <.link
                patch={~p"/programs/computer-science-engineering"}
                class="flex-1 px-3 py-2 text-xs font-medium text-white bg-violet-600 hover:bg-violet-700 dark:bg-violet-700 dark:hover:bg-violet-600 rounded-lg transition-colors text-center sm:text-sm"
              >
                View Colleges Offering This Program
              </.link>
            </div>
          </div>
        </div>

        <!-- Program Card 2 -->
        <div class="bg-white dark:bg-gray-800 shadow-md border border-gray-100 dark:border-gray-700 rounded-xl sm:rounded-2xl overflow-hidden hover:shadow-lg transition-all duration-200 group">
          <div class="p-4 sm:p-5">
              <div class="flex items-start justify-between mb-3">
                <div class="flex-1">
                  <div class="flex items-center space-x-2 mb-2">
                    <span class="inline-flex items-center px-2 py-1 text-xs font-medium text-white bg-blue-600 rounded-full">
                      B.Tech
                    </span>
                    <span class="inline-flex items-center px-2 py-1 text-xs font-medium text-blue-700 dark:text-blue-300 bg-blue-100 dark:bg-blue-900/30 rounded-full">
                      4 Years
                    </span>
                  </div>
                  <h3 class="font-bold text-gray-900 dark:text-white text-base sm:text-lg mb-1">Mechanical Engineering</h3>
                  <p class="text-sm text-gray-600 dark:text-gray-400">
                    Core engineering program offered in 92 colleges
                  </p>
                </div>
                <div class="ml-2">
                  <div class="flex items-center justify-center w-8 h-8 bg-blue-100 dark:bg-blue-900/30 rounded-full">
                    <span class="text-sm font-semibold text-blue-700 dark:text-blue-300">92</span>
                  </div>
                </div>
              </div>

              <div class="flex items-center justify-between mb-4 px-3 py-2 bg-gray-50 dark:bg-gray-700/50 rounded-lg">
                <div class="flex items-center">
                  <svg class="w-4 h-4 mr-2 text-gray-500 dark:text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                  </svg>
                  <span class="text-sm text-gray-700 dark:text-gray-300">B.Tech • 4 Years</span>
                </div>
                <div class="flex items-center">
                  <span class="text-xs text-gray-500 dark:text-gray-400">Available at IITs, NITs, GFTIs, IIITs</span>
                </div>
              </div>

            <div class="flex space-x-2">
              <.link
                patch={~p"/programs/mechanical-engineering"}
                class="flex-1 px-3 py-2 text-xs font-medium text-white bg-violet-600 hover:bg-violet-700 dark:bg-violet-700 dark:hover:bg-violet-600 rounded-lg transition-colors text-center sm:text-sm"
              >
                View Colleges
              </.link>
            </div>
          </div>
        </div>

        <!-- Program Card 3 -->
        <div class="bg-white dark:bg-gray-800 shadow-md border border-gray-100 dark:border-gray-700 rounded-xl sm:rounded-2xl overflow-hidden hover:shadow-lg transition-all duration-200 group">
          <div class="p-4 sm:p-5">
              <div class="flex items-start justify-between mb-3">
                <div class="flex-1">
                  <div class="flex items-center space-x-2 mb-2">
                    <span class="inline-flex items-center px-2 py-1 text-xs font-medium text-white bg-green-600 rounded-full">
                      B.Tech
                    </span>
                    <span class="inline-flex items-center px-2 py-1 text-xs font-medium text-green-700 dark:text-green-300 bg-green-100 dark:bg-green-900/30 rounded-full">
                      4 Years
                    </span>
                  </div>
                  <h3 class="font-bold text-gray-900 dark:text-white text-base sm:text-lg mb-1">Electronics and Communication</h3>
                  <p class="text-sm text-gray-600 dark:text-gray-400">
                    Popular electronics program offered in 78 colleges
                  </p>
                </div>
                <div class="ml-2">
                  <div class="flex items-center justify-center w-8 h-8 bg-blue-100 dark:bg-blue-900/30 rounded-full">
                    <span class="text-sm font-semibold text-blue-700 dark:text-blue-300">78</span>
                  </div>
                </div>
              </div>

              <div class="flex items-center justify-between mb-4 px-3 py-2 bg-gray-50 dark:bg-gray-700/50 rounded-lg">
                <div class="flex items-center">
                  <svg class="w-4 h-4 mr-2 text-gray-500 dark:text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                  </svg>
                  <span class="text-sm text-gray-700 dark:text-gray-300">B.Tech • 4 Years</span>
                </div>
                <div class="flex items-center">
                  <span class="text-xs text-gray-500 dark:text-gray-400">Available at IITs, NITs, GFTIs, IIITs</span>
                </div>
              </div>

            <div class="flex space-x-2">
              <.link
                patch={~p"/programs/electronics-communication"}
                class="flex-1 px-3 py-2 text-xs font-medium text-white bg-violet-600 hover:bg-violet-700 dark:bg-violet-700 dark:hover:bg-violet-600 rounded-lg transition-colors text-center sm:text-sm"
              >
                View Colleges
              </.link>
            </div>
          </div>
        </div>

      </div> --%>
      </section>
    </div>
  </div>
</Layouts.app>
