<Layouts.app flash={@flash}>
  <div
    class="min-h-screen bg-stone-50 dark:bg-zinc-950 transition-colors duration-200"
    phx-hook="FavoritesHook"
    id="favorites-container"
  >
    <%!-- ===== HEADER ===== --%>
    <section class="px-4 pt-8 pb-0 sm:pt-14 max-w-7xl mx-auto sm:px-6 lg:px-8">
      <.breadcrumb class="mb-6">
        <:item navigate={~p"/colleges"}>Colleges</:item>
        <:item navigate={~p"/colleges/#{@college}"}>{@college.name}</:item>
        <:item navigate={~p"/programs/#{@program}"}>{@program.name}</:item>
      </.breadcrumb>

      <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4">
        <div class="min-w-0">
          <span class="inline-block text-[10px] font-bold tracking-wider uppercase px-2 py-1 rounded-full bg-amber-100 text-amber-700 dark:bg-amber-500/15 dark:text-amber-400 mb-3">
            {@program.degree_type} &middot; {@program.duration} Years
          </span>

          <h1 class="font-serif text-3xl sm:text-4xl lg:text-[3.5rem] text-stone-900 dark:text-zinc-50 tracking-tight leading-[1.08]">
            {@program.name}
          </h1>
          <div class="w-14 h-[3px] bg-amber-500 mt-5 mb-3"></div>
          <p class="text-stone-400 dark:text-zinc-500 text-lg">
            <.link
              navigate={~p"/colleges/#{@college}"}
              class="hover:text-amber-600 dark:hover:text-amber-400 transition-colors"
            >
              {@college.name}
            </.link>
            &middot; {@college.location}
          </p>
        </div>

        <%!-- Actions --%>
        <div class="flex items-center gap-2 shrink-0 sm:mt-2">
          <button
            type="button"
            id="favorite-btn-college-program"
            class="inline-flex items-center gap-2 px-4 py-2.5 text-[15px] font-medium rounded-lg border border-stone-300 dark:border-zinc-700 text-stone-600 dark:text-zinc-300 bg-white dark:bg-zinc-900 hover:border-amber-500 hover:text-amber-600 dark:hover:border-amber-500 dark:hover:text-amber-400 transition-colors whitespace-nowrap"
            data-id={@college.id}
            data-program-id={@program.id}
            data-type="college_program"
            phx-hook="FavoriteButton"
            title="Add to favorites"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
            </svg>
            <span class="favorite-text">Favorite</span>
          </button>

          <button
            type="button"
            id="share-btn-college-program"
            class="inline-flex items-center gap-2 px-4 py-2.5 text-[15px] font-medium rounded-lg border border-stone-300 dark:border-zinc-700 text-stone-600 dark:text-zinc-300 bg-white dark:bg-zinc-900 hover:border-amber-500 hover:text-amber-600 dark:hover:border-amber-500 dark:hover:text-amber-400 transition-colors"
            phx-hook="ShareHook"
            data-title={"#{@program.name} at #{@college.name}"}
            data-url={url(CounsellingWeb.Endpoint, ~p"/colleges/#{@college}/programs/#{@program}")}
            title="Share program"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.367 2.684 3 3 0 00-5.367-2.684z" />
            </svg>
            Share
          </button>

          <.link
            href={@college.website}
            target="_blank"
            class="inline-flex items-center gap-2 px-4 py-2.5 text-[15px] font-medium rounded-lg bg-stone-900 dark:bg-zinc-100 text-white dark:text-zinc-900 hover:bg-stone-800 dark:hover:bg-zinc-200 transition-colors"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
            Website
          </.link>
        </div>
      </div>
    </section>

    <%!-- ===== STATS STRIP ===== --%>
    <section class="px-4 py-8 sm:py-10 max-w-7xl mx-auto sm:px-6 lg:px-8">
      <div class="grid grid-cols-3 gap-6 sm:gap-8">
        <div>
          <div class="font-serif text-3xl sm:text-4xl text-stone-900 dark:text-zinc-100">
            {@program.duration}
          </div>
          <div class="mt-1.5 text-xs uppercase tracking-[0.15em] text-stone-400 dark:text-zinc-500 font-medium">
            Years
          </div>
        </div>
        <div>
          <div class="font-serif text-3xl sm:text-4xl text-stone-900 dark:text-zinc-100">
            {@college.class}
          </div>
          <div class="mt-1.5 text-xs uppercase tracking-[0.15em] text-stone-400 dark:text-zinc-500 font-medium">
            Institute Type
          </div>
        </div>
        <div>
          <div class="font-serif text-3xl sm:text-4xl text-stone-900 dark:text-zinc-100">
            <%= if nirf_current = Enum.find(@college.nirf_rankings, fn r -> r.year == @latest_year end) do %>
              {nirf_helper(nirf_current.nirf_rank)}
            <% else %>
              &mdash;
            <% end %>
          </div>
          <div class="mt-1.5 text-xs uppercase tracking-[0.15em] text-stone-400 dark:text-zinc-500 font-medium">
            NIRF {@latest_year}
          </div>
        </div>
      </div>
    </section>

    <%!-- Divider --%>
    <div class="flex items-center gap-4 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex-1 h-px bg-stone-200 dark:bg-zinc-800"></div>
      <div class="w-1.5 h-1.5 rounded-full bg-amber-500"></div>
      <div class="flex-1 h-px bg-stone-200 dark:bg-zinc-800"></div>
    </div>

    <%!-- ===== RANK CUTOFFS (LiveTable) ===== --%>
    <section class="px-4 py-10 sm:py-14 max-w-7xl mx-auto sm:px-6 lg:px-8">
      <div class="flex items-baseline justify-between mb-6">
        <div>
          <div class="w-10 h-1 bg-amber-500 rounded-full mb-5"></div>
          <h2 class="font-serif text-2xl sm:text-3xl text-stone-900 dark:text-zinc-50">
            Rank Cutoffs
          </h2>
          <p class="text-sm text-stone-400 dark:text-zinc-500 mt-1">
            {@latest_year} JoSAA &middot; Filter by category, quota, gender
          </p>
        </div>
      </div>

      <.help_pill id="help-college-program-cutoffs" class="mb-4">
        <strong>Tip:</strong>
        Filter by category (OPEN, OBC-NCL, etc.) and quota (All India, Home State) to see
        the exact cutoff for your situation. Scroll down for historical trend charts.
      </.help_pill>

      <div id="category-filter-hook" phx-hook="CategoryFilterHook" class="hidden"></div>
      <div class="border border-stone-200 dark:border-zinc-800 rounded-xl overflow-hidden bg-white dark:bg-zinc-900">
        <.live_table
          fields={fields()}
          filters={filters_for(@college.class)}
          options={@options}
          streams={@streams}
          class="min-w-full"
        />
      </div>

      <p class="text-xs text-stone-400 dark:text-zinc-600 mt-3">
        Cutoff ranks for JEE Main {@latest_year}. Data sourced from JoSAA.
      </p>
    </section>

    <%!-- Divider --%>
    <div class="flex items-center gap-4 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex-1 h-px bg-stone-200 dark:bg-zinc-800"></div>
      <div class="w-1.5 h-1.5 rounded-full bg-amber-500"></div>
      <div class="flex-1 h-px bg-stone-200 dark:bg-zinc-800"></div>
    </div>

    <%!-- ===== HISTORICAL TRENDS ===== --%>
    <section class="px-4 py-10 sm:py-14 max-w-7xl mx-auto sm:px-6 lg:px-8">
      <div class="w-10 h-1 bg-amber-500 rounded-full mb-5"></div>
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3 mb-6">
        <div>
          <h2 class="font-serif text-2xl sm:text-3xl text-stone-900 dark:text-zinc-50 mb-1">
            Historical Trends
          </h2>
          <p class="text-sm text-stone-400 dark:text-zinc-500" data-chart-subtitle>
            Opening &rarr; Closing range by quota &middot; syncs with your category
          </p>
        </div>
      </div>

      <div
        id="cutoff-trends-chart"
        phx-hook="CutoffChartHook"
        data-all-cutoffs={
          Jason.encode!(
            @all_cutoffs
            |> Enum.map(fn rc ->
              %{
                opening_rank: rc.opening_rank,
                closing_rank: rc.closing_rank,
                quota: rc.quota,
                gender: rc.gender,
                seat_type: rc.seat_type,
                year: rc.year
              }
            end)
          )
        }
      >
        <div class="border border-stone-200 dark:border-zinc-800 rounded-xl bg-white dark:bg-zinc-900 overflow-hidden">
          <%!-- Chart toolbar --%>
          <div class="flex items-center justify-between px-4 sm:px-6 py-3 border-b border-stone-100 dark:border-zinc-800/60">
            <div
              data-chart-legends
              class="flex items-center gap-3 text-xs text-stone-400 dark:text-zinc-500"
            >
              <%!-- Populated dynamically by CutoffChartHook based on available quotas --%>
            </div>
            <button
              data-gender-toggle
              type="button"
              class="text-[11px] font-medium px-3 py-1.5 rounded-full border transition-colors bg-stone-100 dark:bg-zinc-800 text-stone-600 dark:text-zinc-400 border-stone-300 dark:border-zinc-700 hover:border-amber-500"
            >
              Showing: Gender Neutral
            </button>
          </div>
          <%!-- Canvas --%>
          <div class="p-4 sm:p-6">
            <canvas id="cutoffTrendsCanvas" class="w-full h-64 sm:h-80"></canvas>
          </div>
        </div>
      </div>

      <p class="mt-3 text-[11px] text-stone-400 dark:text-zinc-600">
        Shaded bands show the opening &rarr; closing rank range. Solid line = closing rank.
      </p>
    </section>
  </div>
</Layouts.app>
