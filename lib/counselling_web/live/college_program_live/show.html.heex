<Layouts.app flash={@flash}>
  <div
    class="min-h-screen bg-gray-50 dark:bg-gray-900 transition-colors duration-200"
    phx-hook="FavoritesHook"
    id="favorites-container"
  >
    
<!-- Hero Section -->
    <div class="relative overflow-hidden bg-gradient-to-br from-violet-600 via-purple-600 to-blue-600">
      <div class="absolute inset-0 bg-black/20"></div>
      <div class="relative px-3 py-8 mx-auto max-w-7xl sm:px-6 lg:px-8 sm:py-12 lg:py-16">
        <!-- Navigation -->
        <nav class="mb-6 sm:mb-8">
          <div class="flex items-center space-x-2 text-sm">
            <.link
              navigate={~p"/colleges"}
              class="text-white/80 hover:text-white transition-colors"
            >
              Colleges
            </.link>
            <span class="text-white/60">/</span>
            <.link
              navigate={~p"/colleges/#{@college}"}
              class="text-white/80 hover:text-white transition-colors"
            >
              {@college.name}
            </.link>
            <span class="text-white/60">/</span>
            <.link
              navigate={~p"/programs/#{@program}"}
              class="text-white/80 hover:text-white transition-colors"
            >
              {@program.name}
            </.link>
          </div>
        </nav>

        <div class="text-center">
          <div class="mb-3 sm:mb-4">
            <span class="inline-flex items-center px-2 py-1 text-xs font-medium text-white bg-white/10 backdrop-blur-sm border border-white/20 rounded-full sm:px-3">
              {@program.degree_type} Program
            </span>
          </div>

          <h1 class="mb-3 text-2xl font-bold tracking-tight text-white sm:mb-4 sm:text-3xl lg:text-5xl">
            {@program.name}
          </h1>

          <h2 class="mb-4 text-lg text-white/90 sm:mb-6 sm:text-xl lg:text-2xl">
            at {@college.name}
          </h2>

          <p class="mb-4 text-base text-white/90 sm:mb-6 sm:text-lg">
            {@program.duration} Year Program • {@college.location} • Est. {@college.established_year}
          </p>

          <div class="mb-4 p-3 bg-white/10 backdrop-blur-sm border border-white/20 rounded-lg text-sm text-white/80 max-w-3xl mx-auto">
            <div class="flex items-start space-x-2">
              <svg
                class="w-4 h-4 mt-0.5 flex-shrink-0"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                >
                </path>
              </svg>
              <div>
                <strong>Cutoff Guide:</strong>
                Opening Rank = Lowest rank admitted, Closing Rank = Highest rank admitted. All India quota is for students from any state, Home State quota is for state residents only. Different cutoffs apply for General, OBC, SC, ST, and EWS categories.
              </div>
            </div>
          </div>

          <div class="flex flex-wrap justify-center gap-2 sm:gap-3">
            <span class="inline-flex items-center px-2 py-1 font-medium text-white bg-white/10 backdrop-blur-sm border border-white/20 rounded-full sm:px-3 text-sm">
              <svg
                class="w-3 h-3 mr-1 sm:w-4 sm:h-4 sm:mr-2"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"
                >
                </path>
              </svg>
              {@college.class} • NIRF #
              <b class="ml-1">
                {Enum.find(@college.nirf_rankings, fn r -> r.year == 2024 end).nirf_rank}
              </b>
            </span>

            <span class="inline-flex items-center px-2 py-1 text-xs font-medium text-white bg-white/10 backdrop-blur-sm border border-white/20 rounded-full sm:px-3 sm:text-sm">
              <svg
                class="w-3 h-3 mr-1 sm:w-4 sm:h-4 sm:mr-2"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"
                >
                </path>
              </svg>
              Latest Cutoffs 2024
            </span>

            <span class="inline-flex items-center px-2 py-1 text-xs font-medium text-white bg-white/10 backdrop-blur-sm border border-white/20 rounded-full sm:px-3 sm:text-sm">
              <svg
                class="w-3 h-3 mr-1 sm:w-4 sm:h-4 sm:mr-2"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"
                >
                </path>
              </svg>
              {@college.campus_area} Acres Campus
            </span>
          </div>
        </div>
      </div>
    </div>
    
<!-- Main Content -->
    <div class="px-4 mx-auto max-w-7xl sm:px-6 lg:px-8">
      <!-- Quick Stats Grid -->
      <section class="relative z-10 mb-6 -mt-4 sm:mb-8 sm:-mt-8 lg:mb-12 lg:-mt-12">
        <div class="grid grid-cols-2 gap-3 sm:grid-cols-4 sm:gap-4 lg:gap-6">
          <div class="relative z-20 p-3 text-center bg-white dark:bg-gray-800 shadow-2xl border border-gray-100 dark:border-gray-700 rounded-xl sm:p-4 lg:p-6">
            <div>
              <RankComponent.rank_display
                class="text-xl font-bold sm:text-2xl lg:text-3xl"
                rank={
                  Enum.find(@rank_cutoffs, fn r ->
                    r.category == :gender_neutral and r.year == 2024
                  end).opening_rank
                }
              />
            </div>
            <div class="text-xs text-gray-600 dark:text-gray-400 sm:text-sm">Opening Rank</div>
          </div>

          <div class="relative z-20 p-3 text-center bg-white dark:bg-gray-800 shadow-2xl border border-gray-100 dark:border-gray-700 rounded-xl sm:p-4 lg:p-6">
            <div
              phx-hook="RankDisplayHook"
              id="closing-rank"
              class="text-xl font-bold text-red-600 dark:text-red-400 sm:text-2xl lg:text-3xl"
            >
              <RankComponent.rank_display
                class="text-xl font-bold sm:text-2xl lg:text-3xl"
                rank={
                  Enum.find(@rank_cutoffs, fn r ->
                    r.category == :gender_neutral and r.year == 2024
                  end).closing_rank
                }
              />
            </div>
            <div class="text-xs text-gray-600 dark:text-gray-400 sm:text-sm">Closing Rank</div>
          </div>

          <div class="relative z-20 p-3 text-center bg-white dark:bg-gray-800 shadow-2xl border border-gray-100 dark:border-gray-700 rounded-xl sm:p-4 lg:p-6">
            <div class="text-xl font-bold text-blue-600 dark:text-blue-400 sm:text-2xl">
              {@program.duration}
            </div>
            <div class="text-xs text-gray-600 dark:text-gray-400 sm:text-sm">Years</div>
          </div>

          <div class="relative z-20 p-3 text-center bg-white dark:bg-gray-800 shadow-2xl border border-gray-100 dark:border-gray-700 rounded-xl sm:p-4 lg:p-6">
            <div class="text-xl font-bold text-violet-600 dark:text-violet-400 sm:text-2xl lg:text-3xl">
              {@college.established_year}
            </div>
            <div class="text-xs text-gray-600 dark:text-gray-400 sm:text-sm">Established</div>
          </div>
        </div>
      </section>
      
<!-- Main Content Grid -->
      <div class="grid gap-6 lg:grid-cols-4 lg:gap-8">
        <!-- Left Sidebar -->
        <div class="space-y-6 lg:col-span-1 lg:space-y-8">
          <!-- Program Details -->
          <section class="p-4 bg-white dark:bg-gray-800 shadow-lg border border-gray-100 dark:border-gray-700 rounded-xl sm:p-6">
            <div class="flex items-center mb-4 sm:mb-6">
              <div class="w-1 h-6 mr-3 bg-gradient-to-b from-violet-500 to-purple-600 rounded-full sm:h-8 sm:mr-4">
              </div>
              <h2 class="text-lg font-bold text-gray-900 dark:text-white sm:text-xl">
                Program Info
              </h2>
            </div>

            <div class="space-y-4">
              <div>
                <h3 class="text-sm font-semibold text-gray-900 dark:text-white mb-1">Program</h3>
                <p class="text-sm text-gray-600 dark:text-gray-400">
                  {@program.name}
                </p>
              </div>

              <div>
                <h3 class="text-sm font-semibold text-gray-900 dark:text-white mb-1">Degree</h3>
                <p class="text-sm text-gray-600 dark:text-gray-400">{@program.degree_type}</p>
              </div>

              <div>
                <h3 class="text-sm font-semibold text-gray-900 dark:text-white mb-1">Duration</h3>
                <p class="text-sm text-gray-600 dark:text-gray-400">{@program.duration} Years</p>
              </div>

              <div>
                <h3 class="text-sm font-semibold text-gray-900 dark:text-white mb-1">College</h3>
                <p class="text-sm text-gray-600 dark:text-gray-400">{@college.name}</p>
              </div>
            </div>
          </section>
          
<!-- Quick Actions -->
          <section class="p-4 bg-white dark:bg-gray-800 shadow-lg border border-gray-100 dark:border-gray-700 rounded-xl sm:p-6">
            <h3 class="mb-3 text-base font-semibold text-gray-900 dark:text-white sm:mb-4 sm:text-lg">
              Quick Actions
            </h3>
            <div class="space-y-2 sm:space-y-3">
              <.link
                href="https://www.iitm.ac.in"
                target="_blank"
                class="flex items-center justify-center w-full px-3 py-2 text-sm font-medium text-white transition-colors bg-violet-600 hover:bg-violet-700 dark:bg-violet-700 dark:hover:bg-violet-600 rounded-lg focus:outline-none focus:ring-2 focus:ring-violet-500 focus:ring-offset-2 dark:focus:ring-offset-gray-800 sm:px-4 sm:py-3"
              >
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                  >
                  </path>
                </svg>
                Visit College Website
              </.link>

              <button
                type="button"
                id="favorite-btn-college-program"
                class="flex items-center justify-center w-full px-3 py-2 text-sm font-medium text-violet-700 dark:text-violet-300 transition-colors bg-violet-100 dark:bg-violet-900/30 border border-violet-200 dark:border-violet-800 rounded-lg hover:bg-violet-200 dark:hover:bg-violet-900/50 focus:outline-none focus:ring-2 focus:ring-violet-500 focus:ring-offset-2 dark:focus:ring-offset-gray-800 sm:px-4 sm:py-3"
                data-id={@college.id}
                data-program-id={@program.id}
                data-type="college_program"
                phx-hook="FavoriteButton"
                title="Add to favorites"
              >
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"
                  >
                  </path>
                </svg>
                <span class="favorite-text">Add to Favorites</span>
              </button>

              <button
                type="button"
                id="share-btn-college-program"
                class="flex items-center justify-center w-full px-3 py-2 text-sm font-medium text-gray-700 dark:text-gray-300 transition-colors bg-gray-100 dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-lg hover:bg-gray-200 dark:hover:bg-gray-600 focus:outline-none focus:ring-2 focus:ring-gray-500 focus:ring-offset-2 dark:focus:ring-offset-gray-800 sm:px-4 sm:py-3"
                phx-hook="ShareHook"
                data-title={"#{@program.name} at #{@college.name}"}
                data-url={
                  url(
                    CounsellingWeb.Endpoint,
                    ~p"/colleges/#{@college}/programs/#{@program}"
                  )
                }
                title="Share program"
              >
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.367 2.684 3 3 0 00-5.367-2.684z"
                  >
                  </path>
                </svg>
                Share Program
              </button>
            </div>
          </section>
        </div>
        
<!-- Main Content -->
        <div class="space-y-6 lg:col-span-3 lg:space-y-8">
          <!-- Rank Cutoffs Section -->
          <section class="p-4 bg-white dark:bg-gray-800 shadow-lg border border-gray-100 dark:border-gray-700 rounded-xl sm:p-6 lg:p-8">
            <div class="flex items-center justify-between mb-4 sm:mb-6">
              <div class="flex items-center">
                <div class="w-1 h-6 mr-3 bg-gradient-to-b from-violet-500 to-purple-600 rounded-full sm:h-8 sm:mr-4">
                </div>
                <h2 class="text-lg font-bold text-gray-900 dark:text-white sm:text-xl lg:text-2xl">
                  Rank Cutoffs
                </h2>
              </div>
            </div>

            <div class="overflow-hidden border border-gray-200 dark:border-gray-600 rounded-lg">
              <div class="overflow-x-auto">
                <table class="w-full min-w-full">
                  <thead class="bg-gray-50 dark:bg-gray-700">
                    <tr>
                      <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">
                        Quota
                      </th>
                      <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">
                        Category
                      </th>
                      <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">
                        Opening Rank
                      </th>
                      <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">
                        Closing Rank
                      </th>
                    </tr>
                  </thead>
                  <tbody class="bg-white dark:bg-gray-800 divide-y divide-gray-200 dark:divide-gray-600">
                    <tr :for={cutoff <- Enum.filter(@rank_cutoffs, fn x -> x.year == 2024 end)}>
                      <td class="px-4 py-4 text-sm text-center font-medium text-gray-900 dark:text-white">
                        {cutoff.quota |> process_quota()}
                      </td>
                      <td class="px-4 py-4 text-sm text-center text-gray-700 dark:text-gray-300">
                        {cutoff.category |> process_category()}
                      </td>
                      <td class="px-4 py-4 text-sm text-center font-semibold text-blue-600 dark:text-blue-400">
                        <RankComponent.rank_badge rank={cutoff.opening_rank} />
                      </td>
                      <td class="px-4 py-4 text-sm text-center font-semibold text-blue-600 dark:text-blue-400">
                        <RankComponent.rank_badge rank={cutoff.closing_rank} />

                        <%!-- {cutoff.closing_rank} --%>
                      </td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>

            <div class="mt-4 p-3 bg-gray-50 dark:bg-gray-700/50 rounded-lg">
              <p class="text-xs text-gray-600 dark:text-gray-400">
                <strong>Note:</strong>
                Cutoff ranks are for the General category.
                <%!-- "-" indicates seats not available for that quota. --%>
                Ranks shown are for JEE Main 2024. Data is updated regularly from official sources.
              </p>
            </div>
          </section>
          
<!-- Historical Trends -->
          <section class="p-4 bg-white dark:bg-gray-800 shadow-lg border border-gray-100 dark:border-gray-700 rounded-xl sm:p-6 lg:p-8">
            <div class="flex items-center mb-4 sm:mb-6">
              <div class="w-1 h-6 mr-3 bg-gradient-to-b from-violet-500 to-purple-600 rounded-full sm:h-8 sm:mr-4">
              </div>
              <h2 class="text-lg font-bold text-gray-900 dark:text-white sm:text-xl lg:text-2xl">
                Historical Trends
              </h2>
            </div>
            
<!-- Chart Container -->
            <div class="mt-6 sm:mt-8">
              <canvas
                id="rankTrendsChart"
                class="w-full h-64 sm:h-80"
                phx-hook="ChartsHook"
                data-chart-type="rank-trends"
                data-rank-cutoffs={
                  Jason.encode!(
                    Enum.map(@rank_cutoffs, fn rc ->
                      %{
                        opening_rank: rc.opening_rank,
                        closing_rank: rc.closing_rank,
                        quota: rc.quota,
                        category: rc.category,
                        year: rc.year
                      }
                    end)
                  )
                }
              >
              </canvas>
            </div>
            
<!-- Legend -->
            <div class="mt-4 grid grid-cols-1 sm:grid-cols-3 gap-4">
              <!-- All India -->
              <div class="p-3 bg-gray-50 dark:bg-gray-700 rounded-lg">
                <h4 class="text-sm font-semibold text-gray-900 dark:text-white mb-2">
                  All India
                </h4>
                <div class="space-y-1">
                  <div class="flex items-center text-xs">
                    <div class="w-3 h-0.5 bg-blue-500 mr-2"></div>
                    <span class="text-gray-600 dark:text-gray-400">Gender Neutral</span>
                  </div>
                  <div class="flex items-center text-xs">
                    <div class="w-3 h-0.5 bg-pink-500 mr-2"></div>
                    <span class="text-gray-600 dark:text-gray-400">Female Only</span>
                  </div>
                </div>
              </div>
              
<!-- Home State -->
              <div
                :if={Enum.any?(@rank_cutoffs, fn x -> x.quota != :all_india end)}
                class="p-3 bg-gray-50 dark:bg-gray-700 rounded-lg"
              >
                <h4 class="text-sm font-semibold text-gray-900 dark:text-white mb-2">
                  Home State
                </h4>
                <div class="space-y-1">
                  <div class="flex items-center text-xs">
                    <div class="w-3 h-0.5 bg-green-500 mr-2"></div>
                    <span class="text-gray-600 dark:text-gray-400">Gender Neutral</span>
                  </div>
                  <div class="flex items-center text-xs">
                    <div class="w-3 h-0.5 bg-emerald-500 mr-2"></div>
                    <span class="text-gray-600 dark:text-gray-400">Female Only</span>
                  </div>
                </div>
              </div>
              
<!-- Other State -->
              <div
                :if={Enum.any?(@rank_cutoffs, fn x -> x.quota != :all_india end)}
                class="p-3 bg-gray-50 dark:bg-gray-700 rounded-lg"
              >
                <h4 class="text-sm font-semibold text-gray-900 dark:text-white mb-2">
                  Other State
                </h4>
                <div class="space-y-1">
                  <div class="flex items-center text-xs">
                    <div class="w-3 h-0.5 bg-orange-500 mr-2"></div>
                    <span class="text-gray-600 dark:text-gray-400">Gender Neutral</span>
                  </div>
                  <div class="flex items-center text-xs">
                    <div class="w-3 h-0.5 bg-red-500 mr-2"></div>
                    <span class="text-gray-600 dark:text-gray-400">Female Only</span>
                  </div>
                </div>
              </div>
            </div>
          </section>
          
<!-- About the Program -->
          <%!-- <section class="p-4 bg-white dark:bg-gray-800 shadow-lg border border-gray-100 dark:border-gray-700 rounded-xl sm:p-6 lg:p-8">
            <div class="flex items-center mb-4 sm:mb-6">
              <div class="w-1 h-6 mr-3 bg-gradient-to-b from-violet-500 to-purple-600 rounded-full sm:h-8 sm:mr-4">
              </div>
              <h2 class="text-lg font-bold text-gray-900 dark:text-white sm:text-xl lg:text-2xl">
                About the Program
              </h2>
            </div>
            <div class="prose prose-sm prose-gray dark:prose-invert max-w-none sm:prose-base">
              <p class="text-gray-700 dark:text-gray-300 leading-relaxed">
                The Computer Science and Engineering program at IIT Madras is one of the most prestigious and competitive programs in India.
                The department offers a comprehensive curriculum covering fundamental and advanced topics in computer science, including algorithms,
                data structures, artificial intelligence, machine learning, and software engineering.
              </p>
              <p class="text-gray-700 dark:text-gray-300 leading-relaxed mt-4">
                Students benefit from world-class faculty, state-of-the-art laboratories, and excellent placement opportunities.
                The program has consistently maintained its position as one of the top computer science programs in the country,
                with graduates going on to work at leading technology companies and pursuing advanced research.
              </p>
            </div>
          </section> --%>
        </div>
      </div>
    </div>
  </div>
</Layouts.app>
