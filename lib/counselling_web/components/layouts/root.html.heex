<!DOCTYPE html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta :if={assigns[:robots]} name="robots" content={assigns[:robots]} />

    <meta
      name="description"
      content={
        assigns[:meta_description] ||
          "JOSAA Counselling Helper - Find engineering colleges and programs based on your JEE rank"
      }
    />

    <%!-- OpenGraph --%>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="JOSAA Counselling Helper" />
    <meta
      property="og:title"
      content={assigns[:page_title] || "JOSAA Counselling Helper"}
    />
    <meta
      property="og:description"
      content={
        assigns[:meta_description] ||
          "Find engineering colleges and programs based on your JEE rank"
      }
    />
    <meta
      property="og:image"
      content={assigns[:og_image] || CounsellingWeb.SEO.default_social_image(url(~p"/"))}
    />
    <meta
      :if={assigns[:canonical_url]}
      property="og:url"
      content={assigns[:canonical_url]}
    />

    <%!-- Twitter Card --%>
    <meta name="twitter:card" content="summary_large_image" />
    <meta
      name="twitter:title"
      content={assigns[:page_title] || "JOSAA Counselling Helper"}
    />
    <meta
      name="twitter:description"
      content={
        assigns[:meta_description] ||
          "Find engineering colleges and programs based on your JEE rank"
      }
    />
    <meta
      name="twitter:image"
      content={assigns[:og_image] || CounsellingWeb.SEO.default_social_image(url(~p"/"))}
    />

    <%!-- Canonical URL --%>
    <link :if={assigns[:canonical_url]} rel="canonical" href={assigns[:canonical_url]} />
    
<!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <.live_title default="JOSAA Counselling Helper">
      {assigns[:page_title]}
    </.live_title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,100..900;1,9..144,100..900&family=Outfit:wght@300..700&display=swap"
      rel="stylesheet"
    />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script phx-track-static type="text/javascript" src={~p"/vendor/chart.umd.min.js"}>
    </script>
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <script
      :for={json_ld <- List.wrap(assigns[:json_ld] || [])}
      type="application/ld+json"
    >
      {Phoenix.HTML.raw(Jason.encode!(json_ld))}
    </script>
    <script>
      (function() {
        const theme = localStorage.getItem('sutra-ui:theme') ||
          (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        if (theme === 'dark') {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }

        window.addEventListener('sutra-ui:set-theme', (e) => {
          const newTheme = e.detail?.theme;
          if (newTheme === 'dark') {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
          localStorage.setItem('sutra-ui:theme', newTheme);
        });

        window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
          if (!localStorage.getItem('sutra-ui:theme')) {
            if (e.matches) {
              document.documentElement.classList.add('dark');
            } else {
              document.documentElement.classList.remove('dark');
            }
          }
        });
      })();
    </script>
    
<!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-JSDMMF18JD">
    </script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-JSDMMF18JD');
    </script>
  </head>
  <body class="bg-stone-50 dark:bg-zinc-950">
    {@inner_content}
  </body>
</html>
