<Layouts.app flash={@flash}>
  <div class="relative overflow-hidden">
    <!-- Warm ambient glow -->
    <div class="pointer-events-none absolute top-0 left-1/4 w-[500px] h-[500px] bg-amber-200/15 dark:bg-amber-600/[0.03] rounded-full blur-3xl">
    </div>
    <div class="pointer-events-none absolute top-40 right-0 w-80 h-80 bg-stone-200/30 dark:bg-zinc-800/20 rounded-full blur-3xl">
    </div>

    <!-- ===== HERO ===== -->
    <section class="relative px-4 pt-20 pb-14 sm:pt-32 sm:pb-20 lg:pt-40 lg:pb-24 max-w-6xl mx-auto sm:px-6 lg:px-8">
      <div class="relative max-w-3xl">
        <!-- Amber accent bar -->
        <div class="animate-fade-up w-10 h-1 bg-amber-500 rounded-full mb-8"></div>

        <!-- Eyebrow -->
        <p
          class="animate-fade-up text-xs uppercase tracking-[0.25em] text-stone-400 dark:text-zinc-500 mb-6 font-medium"
          style="animation-delay: 0.05s"
        >
          JOSAA 2025 &mdash; Official Cutoff Data
        </p>

        <!-- Headline -->
        <h1
          class="animate-fade-up font-serif text-[3rem] sm:text-[4rem] lg:text-[5.5rem] leading-[1.06] tracking-tight text-stone-900 dark:text-zinc-50"
          style="animation-delay: 0.1s"
        >
          Your rank.
          <br class="hidden sm:block" />
          Your colleges.
          <br />
          <em class="italic text-amber-600 dark:text-amber-400">Sorted.</em>
        </h1>

        <!-- Subtext -->
        <p
          class="animate-fade-up mt-8 text-lg sm:text-xl text-stone-500 dark:text-zinc-400 max-w-lg leading-relaxed"
          style="animation-delay: 0.2s"
        >
          Enter your JEE rank and instantly see which IITs, NITs, and IIITs
          you can get into &mdash; color-coded for clarity.
        </p>

        <!-- CTAs -->
        <div
          class="animate-fade-up flex flex-wrap items-center gap-4 mt-10"
          style="animation-delay: 0.3s"
        >
          <SutraUI.Button.button navigate={~p"/colleges"} size="lg">
            Explore Colleges &rarr;
          </SutraUI.Button.button>
          <SutraUI.Button.button navigate={~p"/programs"} variant="ghost" size="lg">
            Browse Programs
          </SutraUI.Button.button>
        </div>
      </div>
    </section>

    <!-- ===== STATS STRIP ===== -->
    <section class="border-y border-stone-200/80 dark:border-zinc-800/80 bg-stone-100/50 dark:bg-zinc-900/30">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-8 sm:gap-12">
          <div>
            <div class="font-serif text-4xl sm:text-5xl text-stone-900 dark:text-zinc-100">
              120+
            </div>
            <div class="mt-2 text-xs uppercase tracking-[0.15em] text-stone-400 dark:text-zinc-500 font-medium">
              Colleges
            </div>
          </div>
          <div>
            <div class="font-serif text-4xl sm:text-5xl text-stone-900 dark:text-zinc-100">
              500+
            </div>
            <div class="mt-2 text-xs uppercase tracking-[0.15em] text-stone-400 dark:text-zinc-500 font-medium">
              Programs
            </div>
          </div>
          <div>
            <div class="font-serif text-4xl sm:text-5xl text-stone-900 dark:text-zinc-100">
              2025
            </div>
            <div class="mt-2 text-xs uppercase tracking-[0.15em] text-stone-400 dark:text-zinc-500 font-medium">
              Cutoff Year
            </div>
          </div>
          <div>
            <div class="font-serif text-4xl sm:text-5xl text-amber-600 dark:text-amber-400">
              Free
            </div>
            <div class="mt-2 text-xs uppercase tracking-[0.15em] text-stone-400 dark:text-zinc-500 font-medium">
              Always
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== HOW IT WORKS ===== -->
    <section class="px-4 py-20 sm:py-28 max-w-6xl mx-auto sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto text-center mb-14 sm:mb-20">
        <div class="w-10 h-1 bg-amber-500 rounded-full mb-6 mx-auto"></div>
        <h2 class="font-serif text-3xl sm:text-4xl lg:text-[2.75rem] text-stone-900 dark:text-zinc-50 leading-snug">
          Three steps to your<br class="hidden sm:block" />
          <em class="italic text-amber-600 dark:text-amber-400">best-fit</em> college
        </h2>
        <p class="mt-5 text-base sm:text-lg text-stone-500 dark:text-zinc-400 leading-relaxed max-w-lg mx-auto">
          Enter your rank once, then browse every college and program with
          cutoffs filtered to your category. No signup needed.
        </p>
      </div>

      <div class="grid gap-8 sm:grid-cols-3">
        <%!-- Step 1 --%>
        <div class="relative">
          <div class="text-[4.5rem] font-serif text-stone-100 dark:text-zinc-800/60 leading-none select-none absolute -top-3 -left-1">
            1
          </div>
          <div class="relative pt-10 pl-1">
            <div class="w-10 h-10 rounded-xl bg-amber-500/10 dark:bg-amber-500/[0.08] flex items-center justify-center mb-4">
              <svg class="w-5 h-5 text-amber-600 dark:text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </div>
            <h3 class="font-serif text-xl text-stone-900 dark:text-zinc-100 mb-2">
              Enter your rank
            </h3>
            <p class="text-[15px] text-stone-500 dark:text-zinc-400 leading-relaxed">
              Type your JEE rank and select your category (OPEN, OBC-NCL, SC, ST, EWS).
              Every page adapts instantly.
            </p>
          </div>
        </div>

        <%!-- Step 2 --%>
        <div class="relative">
          <div class="text-[4.5rem] font-serif text-stone-100 dark:text-zinc-800/60 leading-none select-none absolute -top-3 -left-1">
            2
          </div>
          <div class="relative pt-10 pl-1">
            <div class="w-10 h-10 rounded-xl bg-amber-500/10 dark:bg-amber-500/[0.08] flex items-center justify-center mb-4">
              <svg class="w-5 h-5 text-amber-600 dark:text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 4h13M3 8h9m-9 4h6m4 0l4-4m0 0l4 4m-4-4v12" />
              </svg>
            </div>
            <h3 class="font-serif text-xl text-stone-900 dark:text-zinc-100 mb-2">
              Filter & sort
            </h3>
            <p class="text-[15px] text-stone-500 dark:text-zinc-400 leading-relaxed">
              Filter by IIT, NIT, IIIT or GFTI. Sort by NIRF ranking or cutoff.
              See color-coded ranks for your exact category.
            </p>
          </div>
        </div>

        <%!-- Step 3 --%>
        <div class="relative">
          <div class="text-[4.5rem] font-serif text-stone-100 dark:text-zinc-800/60 leading-none select-none absolute -top-3 -left-1">
            3
          </div>
          <div class="relative pt-10 pl-1">
            <div class="w-10 h-10 rounded-xl bg-amber-500/10 dark:bg-amber-500/[0.08] flex items-center justify-center mb-4">
              <svg class="w-5 h-5 text-amber-600 dark:text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
              </svg>
            </div>
            <h3 class="font-serif text-xl text-stone-900 dark:text-zinc-100 mb-2">
              Compare & decide
            </h3>
            <p class="text-[15px] text-stone-500 dark:text-zinc-400 leading-relaxed">
              Add colleges to compare side by side &mdash; cutoffs, NIRF rankings,
              and historical trends in one view.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Decorative divider -->
    <div class="flex items-center gap-4 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex-1 h-px bg-stone-200 dark:bg-zinc-800"></div>
      <div class="w-1.5 h-1.5 rounded-full bg-amber-500"></div>
      <div class="flex-1 h-px bg-stone-200 dark:bg-zinc-800"></div>
    </div>

    <!-- ===== FEATURES ===== -->
    <section class="px-4 py-20 sm:py-28 max-w-6xl mx-auto sm:px-6 lg:px-8">
      <div class="grid gap-6 sm:grid-cols-3">
        <SutraUI.Card.card class="border-t-2 border-t-amber-500">
          <:content>
            <div class="text-xs font-semibold uppercase tracking-[0.2em] text-amber-600 dark:text-amber-400 mb-4">
              Live Filtering
            </div>
            <h3 class="font-serif text-2xl text-stone-900 dark:text-zinc-100 mb-3">
              Instant results
            </h3>
            <p class="text-base text-stone-500 dark:text-zinc-400 leading-relaxed">
              Every page updates as you type your rank. Built with Phoenix
              LiveView for zero-reload speed.
            </p>
          </:content>
        </SutraUI.Card.card>

        <SutraUI.Card.card class="border-t-2 border-t-amber-500">
          <:content>
            <div class="text-xs font-semibold uppercase tracking-[0.2em] text-amber-600 dark:text-amber-400 mb-4">
              Official Data
            </div>
            <h3 class="font-serif text-2xl text-stone-900 dark:text-zinc-100 mb-3">
              Verified cutoffs
            </h3>
            <p class="text-base text-stone-500 dark:text-zinc-400 leading-relaxed">
              JOSAA cutoffs and NIRF rankings sourced directly from official
              records. All categories covered.
            </p>
          </:content>
        </SutraUI.Card.card>

        <SutraUI.Card.card class="border-t-2 border-t-amber-500">
          <:content>
            <div class="text-xs font-semibold uppercase tracking-[0.2em] text-amber-600 dark:text-amber-400 mb-4">
              Smart Compare
            </div>
            <h3 class="font-serif text-2xl text-stone-900 dark:text-zinc-100 mb-3">
              Side by side
            </h3>
            <p class="text-base text-stone-500 dark:text-zinc-400 leading-relaxed">
              Compare colleges with NIRF rankings, cutoff trends, and
              program details in one view.
            </p>
          </:content>
        </SutraUI.Card.card>
      </div>
    </section>

    <!-- ===== CTA ===== -->
    <section class="px-4 pb-20 sm:pb-28 max-w-6xl mx-auto sm:px-6 lg:px-8">
      <SutraUI.Card.card class="bg-stone-100 dark:bg-zinc-900 relative overflow-hidden">
        <:content class="py-10 sm:py-14 px-2 sm:px-6">
          <!-- Decorative circles -->
          <div class="absolute top-8 right-10 w-28 h-28 border border-amber-300/30 dark:border-amber-500/10 rounded-full pointer-events-none">
          </div>
          <div class="absolute bottom-6 right-20 w-14 h-14 border border-amber-300/20 dark:border-amber-500/[0.06] rounded-full pointer-events-none">
          </div>

          <div class="relative max-w-lg">
            <h2 class="font-serif text-3xl sm:text-4xl text-stone-900 dark:text-zinc-50">
              Ready to find <em class="italic text-amber-600 dark:text-amber-400">your</em>
              college?
            </h2>
            <p class="mt-4 text-base sm:text-lg text-stone-500 dark:text-zinc-400">
              No registration. No ads. Just accurate data and instant results.
            </p>
            <div class="mt-8">
              <SutraUI.Button.button navigate={~p"/colleges"} size="lg">
                Start Exploring &rarr;
              </SutraUI.Button.button>
            </div>
          </div>
        </:content>
      </SutraUI.Card.card>
    </section>

    <!-- ===== FOOTER ===== -->
    <footer class="px-4 py-10 max-w-6xl mx-auto sm:px-6 lg:px-8 border-t border-stone-200 dark:border-zinc-800">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div class="flex items-center gap-2">
          <span class="font-serif text-lg text-stone-900 dark:text-zinc-100">
            JOSAA Guide
          </span>
          <span class="w-1 h-1 rounded-full bg-amber-500"></span>
          <span class="text-sm text-stone-400 dark:text-zinc-600">
            Built by
            <a
              href="https://github.com/gurujada"
              target="_blank"
              rel="noopener noreferrer"
              class="text-stone-500 dark:text-zinc-400 hover:text-amber-600 dark:hover:text-amber-400 transition-colors underline underline-offset-2 decoration-stone-300 dark:decoration-zinc-700 hover:decoration-amber-500"
            >
              Gurujada
            </a>
          </span>
        </div>
        <div class="flex gap-6 text-sm text-stone-400 dark:text-zinc-500">
          <.link
            navigate={~p"/colleges"}
            class="hover:text-amber-600 dark:hover:text-amber-400 transition-colors"
          >
            Colleges
          </.link>
          <.link
            navigate={~p"/programs"}
            class="hover:text-amber-600 dark:hover:text-amber-400 transition-colors"
          >
            Programs
          </.link>
        </div>
      </div>
    </footer>
  </div>
</Layouts.app>
