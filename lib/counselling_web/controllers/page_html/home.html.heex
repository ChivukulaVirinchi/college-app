<Layouts.app flash={@flash}>
  <div class="min-h-screen bg-gray-50 dark:bg-gray-900 transition-colors duration-200">
    <!-- Hero Section -->
    <div class="relative overflow-hidden bg-gradient-to-br from-violet-600 via-purple-600 to-blue-600">
      <div class="absolute inset-0 bg-black/20"></div>
      <div class="relative px-4 py-12 mx-auto max-w-7xl sm:px-6 lg:px-8 sm:py-16 lg:py-24">
        <!-- Navigation -->
        <nav class="flex items-center justify-between mb-8 sm:mb-12">
          <div class="flex items-center">
            <div class="flex items-center space-x-2">
              <div class="w-8 h-8 bg-white/20 backdrop-blur-sm rounded-lg flex items-center justify-center">
                <svg
                  class="w-5 h-5 text-white"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"
                  >
                  </path>
                </svg>
              </div>
              <span class="text-xl font-bold text-white">JOSAA Helper</span>
            </div>
          </div>
          <div class="flex items-center space-x-4">
            <.link
              navigate={~p"/colleges"}
              class="px-4 py-2 text-sm font-medium text-white bg-white/10 backdrop-blur-sm border border-white/20 rounded-lg hover:bg-white/20 transition-colors"
            >
              Colleges
            </.link>
            <.link
              navigate={~p"/programs"}
              class="px-4 py-2 text-sm font-medium text-white bg-white/10 backdrop-blur-sm border border-white/20 rounded-lg hover:bg-white/20 transition-colors"
            >
              Programs
            </.link>
          </div>
        </nav>
        
<!-- Hero Content -->
        <div class="text-center">
          <div class="mb-4 sm:mb-6">
            <span class="inline-flex items-center px-3 py-1 text-sm font-medium text-white bg-white/10 backdrop-blur-sm border border-white/20 rounded-full">
              <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13 10V3L4 14h7v7l9-11h-7z"
                >
                </path>
              </svg>
              JOSAA Counselling 2024
            </span>
          </div>

          <h1 class="mb-4 text-3xl font-bold tracking-tight text-white sm:mb-6 sm:text-4xl lg:text-6xl lg:leading-tight">
            JOSAA Counselling <br class="hidden sm:block" />
            <span class="bg-gradient-to-r from-yellow-300 to-orange-300 bg-clip-text text-transparent">
              Made Simple
            </span>
          </h1>

          <p class="mb-6 text-lg text-white/90 sm:mb-8 sm:text-xl lg:text-2xl max-w-3xl mx-auto">
            Real-time college filtering, accurate cutoff data, and smart recommendations for informed engineering college decisions.
          </p>

          <div class="mb-6 p-3 bg-white/10 backdrop-blur-sm border border-white/20 rounded-lg text-sm text-white/80 max-w-2xl mx-auto">
            <div class="flex items-start space-x-2">
              <svg
                class="w-4 h-4 mt-0.5 flex-shrink-0"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                >
                </path>
              </svg>
              <div>
                <strong>Quick Start:</strong>
                Enter your JEE Main/Advanced rank to see which colleges you can get into. Color-coded badges show your admission chances: <span class="text-green-300">Green (Safe)</span>, <span class="text-yellow-300">Orange (Possible)</span>, <span class="text-red-300">Red (Difficult)</span>.
              </div>
            </div>
          </div>

          <div class="flex flex-col items-center space-y-4 sm:flex-row sm:justify-center sm:space-y-0 sm:space-x-4">
            <.link
              navigate={~p"/colleges"}
              class="w-full px-8 py-4 text-lg font-semibold text-violet-700 bg-white rounded-xl hover:bg-gray-50 transition-colors focus:ring-4 focus:ring-white/30 sm:w-auto"
            >
              Browse Colleges
            </.link>
            <.link
              navigate={~p"/programs"}
              class="w-full px-8 py-4 text-lg font-semibold text-white bg-white/10 backdrop-blur-sm border border-white/20 rounded-xl hover:bg-white/20 transition-colors focus:ring-4 focus:ring-white/30 sm:w-auto"
            >
              View Programs
            </.link>
          </div>
          
<!-- Trust Indicators -->
          <div class="flex flex-wrap justify-center gap-4 mt-8 sm:gap-6 sm:mt-12">
            <div class="flex items-center px-3 py-2 text-sm text-white bg-white/10 backdrop-blur-sm border border-white/20 rounded-full">
              <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"
                >
                </path>
              </svg>
              120+ Colleges
            </div>
            <div class="flex items-center px-3 py-2 text-sm text-white bg-white/10 backdrop-blur-sm border border-white/20 rounded-full">
              <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"
                >
                </path>
              </svg>
              Latest 2024 Cutoffs
            </div>
            <div class="flex items-center px-3 py-2 text-sm text-white bg-white/10 backdrop-blur-sm border border-white/20 rounded-full">
              <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13 10V3L4 14h7v7l9-11h-7z"
                >
                </path>
              </svg>
              Real-time Updates
            </div>
          </div>
        </div>
      </div>
    </div>
    
<!-- Main Content -->
    <div class="px-4 mx-auto max-w-7xl sm:px-6 lg:px-8">
      <!-- Features Section -->
      <section class="py-12 sm:py-16 lg:py-20">
        <div class="text-center mb-12 sm:mb-16">
          <h2 class="text-2xl font-bold text-gray-900 dark:text-white sm:text-3xl lg:text-4xl mb-4">
            Everything You Need for JOSAA Counselling
          </h2>
          <p class="text-lg text-gray-600 dark:text-gray-400 max-w-3xl mx-auto">
            Comprehensive tools and accurate data to help you make informed engineering college decisions.
          </p>
        </div>

        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 sm:gap-8">
          <div class="p-6 bg-white dark:bg-gray-800 shadow-md border border-gray-100 dark:border-gray-700 rounded-xl sm:p-8">
            <div class="w-12 h-12 bg-violet-100 dark:bg-violet-900/30 rounded-xl flex items-center justify-center mb-4">
              <svg
                class="w-6 h-6 text-violet-600 dark:text-violet-400"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13 10V3L4 14h7v7l9-11h-7z"
                >
                </path>
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-3">
              Real-time Filtering
            </h3>
            <p class="text-gray-600 dark:text-gray-400">
              Enter your JEE rank and instantly see colleges where you have admission chances. Your rank is saved locally and automatically filters all pages.
            </p>
          </div>

          <div class="p-6 bg-white dark:bg-gray-800 shadow-md border border-gray-100 dark:border-gray-700 rounded-xl sm:p-8">
            <div class="w-12 h-12 bg-blue-100 dark:bg-blue-900/30 rounded-xl flex items-center justify-center mb-4">
              <svg
                class="w-6 h-6 text-blue-600 dark:text-blue-400"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"
                >
                </path>
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-3">
              Accurate Cutoff Data
            </h3>
            <p class="text-gray-600 dark:text-gray-400">
              Latest JOSAA cutoff ranks for all colleges and programs. Includes opening/closing ranks for different quotas (All India, Home State, Other State) and categories.
            </p>
          </div>

          <div class="p-6 bg-white dark:bg-gray-800 shadow-md border border-gray-100 dark:border-gray-700 rounded-xl sm:p-8">
            <div class="w-12 h-12 bg-green-100 dark:bg-green-900/30 rounded-xl flex items-center justify-center mb-4">
              <svg
                class="w-6 h-6 text-green-600 dark:text-green-400"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"
                >
                </path>
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-3">
              Smart Comparison
            </h3>
            <p class="text-gray-600 dark:text-gray-400">
              Compare colleges side-by-side with detailed metrics including NIRF rankings, cutoffs, and program offerings to make informed decisions.
            </p>
          </div>
        </div>
      </section>
      
<!-- How It Works Section -->
      <section class="py-12 sm:py-16 lg:py-20 bg-gradient-to-r from-violet-50 to-purple-50 dark:from-violet-900/20 dark:to-purple-900/20 rounded-3xl">
        <div class="px-6 sm:px-8 lg:px-12">
          <div class="text-center mb-12 sm:mb-16">
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white sm:text-3xl lg:text-4xl mb-4">
              How JOSAA Helper Works
            </h2>
            <p class="text-lg text-gray-600 dark:text-gray-400 max-w-3xl mx-auto">
              Simple, fast, and accurate college recommendations based on your JEE rank and preferences.
            </p>
          </div>

          <div class="grid gap-8 lg:grid-cols-2 lg:gap-12 items-center">
            <div class="space-y-6">
              <div class="flex items-start space-x-4">
                <div class="flex-shrink-0 w-10 h-10 bg-violet-100 dark:bg-violet-900/30 rounded-lg flex items-center justify-center">
                  <span class="text-lg font-bold text-violet-600 dark:text-violet-400">1</span>
                </div>
                <div>
                  <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">
                    Enter Your Details
                  </h3>
                  <p class="text-gray-600 dark:text-gray-400">
                    Input your JEE rank, category, and quota preferences. Your rank is remembered across all pages for instant filtering and personalized recommendations.
                  </p>
                </div>
              </div>

              <div class="flex items-start space-x-4">
                <div class="flex-shrink-0 w-10 h-10 bg-blue-100 dark:bg-blue-900/30 rounded-lg flex items-center justify-center">
                  <span class="text-lg font-bold text-blue-600 dark:text-blue-400">2</span>
                </div>
                <div>
                  <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">
                    Get Instant Results
                  </h3>
                  <p class="text-gray-600 dark:text-gray-400">
                    See all colleges and programs where you have admission chances, sorted by relevance and your preferences.
                  </p>
                </div>
              </div>

              <div class="flex items-start space-x-4">
                <div class="flex-shrink-0 w-10 h-10 bg-green-100 dark:bg-green-900/30 rounded-lg flex items-center justify-center">
                  <span class="text-lg font-bold text-green-600 dark:text-green-400">3</span>
                </div>
                <div>
                  <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">
                    Compare & Decide
                  </h3>
                  <p class="text-gray-600 dark:text-gray-400">
                    Compare colleges side-by-side, view detailed information, and make informed decisions for your counselling.
                  </p>
                </div>
              </div>

              <div class="flex items-start space-x-4">
                <div class="flex-shrink-0 w-10 h-10 bg-orange-100 dark:bg-orange-900/30 rounded-lg flex items-center justify-center">
                  <svg
                    class="w-5 h-5 text-orange-600 dark:text-orange-400"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M13 10V3L4 14h7v7l9-11h-7z"
                    >
                    </path>
                  </svg>
                </div>
                <div>
                  <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">
                    Real-time Updates
                  </h3>
                  <p class="text-gray-600 dark:text-gray-400">
                    All filtering happens instantly with Phoenix LiveView technology. No page reloads, just fast results.
                  </p>
                </div>
              </div>
            </div>

            <div class="relative">
              <div class="bg-white dark:bg-gray-800 shadow-2xl border border-gray-100 dark:border-gray-700 rounded-2xl p-6 sm:p-8">
                <div class="mb-6">
                  <div class="flex items-center space-x-2 mb-4">
                    <div class="w-3 h-3 bg-red-500 rounded-full"></div>
                    <div class="w-3 h-3 bg-yellow-500 rounded-full"></div>
                    <div class="w-3 h-3 bg-green-500 rounded-full"></div>
                  </div>
                  <div class="text-sm text-gray-500 dark:text-gray-400 mb-2">josaahelper.com</div>
                  <h4 class="text-lg font-semibold text-gray-900 dark:text-white">
                    Find Colleges for Rank: 45,000
                  </h4>
                  <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">
                    ✓ Shows only colleges where you have admission chances
                  </p>
                </div>

                <div class="space-y-3">
                  <div class="flex items-center justify-between p-3 bg-violet-50 dark:bg-violet-900/20 border border-violet-200 dark:border-violet-800 rounded-lg">
                    <div>
                      <div class="font-medium text-gray-900 dark:text-white">NIT Rourkela</div>
                      <div class="text-sm text-gray-600 dark:text-gray-400">
                        Bio Medical Engineering • NIRF Rank #16
                      </div>
                    </div>
                    <div class="text-sm text-violet-600 dark:text-violet-400 font-medium">
                      Possible
                    </div>
                  </div>

                  <div class="flex items-center justify-between p-3 bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800 rounded-lg">
                    <div>
                      <div class="font-medium text-gray-900 dark:text-white">NIT Nagpur</div>
                      <div class="text-sm text-gray-600 dark:text-gray-400">
                        Civil Engineering• NIRF Rank #41
                      </div>
                    </div>
                    <div class="text-sm text-blue-600 dark:text-blue-400 font-medium">Safe</div>
                  </div>

                  <div class="flex items-center justify-between p-3 bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 rounded-lg">
                    <div>
                      <div class="font-medium text-gray-900 dark:text-white">NIT Meghalaya</div>
                      <div class="text-sm text-gray-600 dark:text-gray-400">
                        Mechanical Engineering • NIRF Rank #68
                      </div>
                    </div>
                    <div class="text-sm text-green-600 dark:text-green-400 font-medium">Safe</div>
                  </div>
                </div>

                <div class="mt-6 text-center">
                  <div class="text-sm text-gray-500 dark:text-gray-400">
                    Updated in real-time ⚡
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
      
<!-- Data & Technology Section -->
      <section class="py-12 sm:py-16 lg:py-20">
        <div class="text-center mb-12 sm:mb-16">
          <h2 class="text-2xl font-bold text-gray-900 dark:text-white sm:text-3xl lg:text-4xl mb-4">
            Built on Reliable Data & Modern Technology
          </h2>
          <p class="text-lg text-gray-600 dark:text-gray-400 max-w-3xl mx-auto">
            Accurate information you can trust, powered by technology that delivers instant results.
          </p>
        </div>

        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 sm:gap-8">
          <div class="p-6 bg-white dark:bg-gray-800 shadow-md border border-gray-100 dark:border-gray-700 rounded-xl text-center sm:p-8">
            <div class="w-16 h-16 bg-violet-100 dark:bg-violet-900/30 rounded-2xl flex items-center justify-center mx-auto mb-4">
              <svg
                class="w-8 h-8 text-violet-600 dark:text-violet-400"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                >
                </path>
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-3">
              Official JOSAA Data
            </h3>
            <p class="text-gray-600 dark:text-gray-400">
              Cutoff ranks sourced directly from official JOSAA counselling data and NIRF rankings.
            </p>
          </div>

          <div class="p-6 bg-white dark:bg-gray-800 shadow-md border border-gray-100 dark:border-gray-700 rounded-xl text-center sm:p-8">
            <div class="w-16 h-16 bg-blue-100 dark:bg-blue-900/30 rounded-2xl flex items-center justify-center mx-auto mb-4">
              <svg
                class="w-8 h-8 text-blue-600 dark:text-blue-400"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13 10V3L4 14h7v7l9-11h-7z"
                >
                </path>
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-3">
              Phoenix LiveView
            </h3>
            <p class="text-gray-600 dark:text-gray-400">
              Real-time filtering and updates without page reloads, delivering instant results as you type.
            </p>
          </div>

          <div class="p-6 bg-white dark:bg-gray-800 shadow-md border border-gray-100 dark:border-gray-700 rounded-xl text-center sm:p-8">
            <div class="w-16 h-16 bg-green-100 dark:bg-green-900/30 rounded-2xl flex items-center justify-center mx-auto mb-4">
              <svg
                class="w-8 h-8 text-green-600 dark:text-green-400"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"
                >
                </path>
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-3">
              Mobile Optimized
            </h3>
            <p class="text-gray-600 dark:text-gray-400">
              Responsive design that works perfectly on mobile devices during counselling sessions.
            </p>
          </div>
        </div>
      </section>
      
<!-- Technical Advantages Section -->
      <section class="py-12 sm:py-16 lg:py-20 bg-gray-100 dark:bg-gray-800 rounded-3xl">
        <div class="px-6 sm:px-8 lg:px-12">
          <div class="text-center mb-12 sm:mb-16">
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white sm:text-3xl lg:text-4xl mb-4">
              What Makes JOSAA Helper Different
            </h2>
            <p class="text-lg text-gray-600 dark:text-gray-400 max-w-3xl mx-auto">
              Technical features designed specifically for JOSAA counselling efficiency and accuracy.
            </p>
          </div>

          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4 sm:gap-8">
            <div class="text-center">
              <div class="w-16 h-16 bg-violet-100 dark:bg-violet-900/30 rounded-2xl flex items-center justify-center mx-auto mb-4">
                <svg
                  class="w-8 h-8 text-violet-600 dark:text-violet-400"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M13 10V3L4 14h7v7l9-11h-7z"
                  >
                  </path>
                </svg>
              </div>
              <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">
                Real-time Filtering
              </h3>
              <p class="text-gray-600 dark:text-gray-400 text-sm">
                Phoenix LiveView technology for instant results without page reloads
              </p>
            </div>

            <div class="text-center">
              <div class="w-16 h-16 bg-blue-100 dark:bg-blue-900/30 rounded-2xl flex items-center justify-center mx-auto mb-4">
                <svg
                  class="w-8 h-8 text-blue-600 dark:text-blue-400"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"
                  >
                  </path>
                </svg>
              </div>
              <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">
                Accurate Data
              </h3>
              <p class="text-gray-600 dark:text-gray-400 text-sm">
                Official JOSAA cutoffs and verified NIRF rankings for reliable decisions
              </p>
            </div>

            <div class="text-center">
              <div class="w-16 h-16 bg-green-100 dark:bg-green-900/30 rounded-2xl flex items-center justify-center mx-auto mb-4">
                <svg
                  class="w-8 h-8 text-green-600 dark:text-green-400"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"
                  >
                  </path>
                </svg>
              </div>
              <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">
                Historical Trends
              </h3>
              <p class="text-gray-600 dark:text-gray-400 text-sm">
                Year-over-year cutoff analysis and ranking trends to predict future patterns
              </p>
            </div>

            <div class="text-center">
              <div class="w-16 h-16 bg-orange-100 dark:bg-orange-900/30 rounded-2xl flex items-center justify-center mx-auto mb-4">
                <svg
                  class="w-8 h-8 text-orange-600 dark:text-orange-400"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"
                  >
                  </path>
                </svg>
              </div>
              <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">
                Mobile Ready
              </h3>
              <p class="text-gray-600 dark:text-gray-400 text-sm">
                Responsive design optimized for mobile counselling sessions
              </p>
            </div>
          </div>
        </div>
      </section>
      
<!-- CTA Section -->
      <section class="py-12 sm:py-16 lg:py-20">
        <div class="text-center">
          <h2 class="text-2xl font-bold text-gray-900 dark:text-white sm:text-3xl lg:text-4xl mb-4">
            Start Your JOSAA Counselling Research
          </h2>
          <p class="text-lg text-gray-600 dark:text-gray-400 max-w-2xl mx-auto mb-8">
            Access comprehensive college data, real-time filtering, and accurate cutoff information.
            No registration required.
          </p>

          <div class="flex flex-col items-center space-y-4 sm:flex-row sm:justify-center sm:space-y-0 sm:space-x-4">
            <.link
              navigate={~p"/colleges"}
              class="w-full px-8 py-4 text-lg font-semibold text-white bg-violet-600 hover:bg-violet-700 dark:bg-violet-700 dark:hover:bg-violet-600 rounded-xl transition-colors focus:ring-4 focus:ring-violet-500/30 sm:w-auto"
            >
              Browse Colleges
            </.link>
            <.link
              navigate={~p"/programs"}
              class="w-full px-8 py-4 text-lg font-semibold text-violet-700 dark:text-violet-300 bg-violet-50 dark:bg-violet-900/30 border border-violet-200 dark:border-violet-700 rounded-xl hover:bg-violet-100 dark:hover:bg-violet-900/50 transition-colors focus:ring-4 focus:ring-violet-500/30 sm:w-auto"
            >
              View Programs
            </.link>
          </div>

          <div class="grid grid-cols-2 gap-8 mt-12 sm:grid-cols-4 sm:gap-12">
            <div class="text-center">
              <div class="text-2xl font-bold text-violet-600 dark:text-violet-400 sm:text-3xl">
                120+
              </div>
              <div class="text-sm text-gray-600 dark:text-gray-400">Engineering Colleges</div>
            </div>
            <div class="text-center">
              <div class="text-2xl font-bold text-blue-600 dark:text-blue-400 sm:text-3xl">
                500+
              </div>
              <div class="text-sm text-gray-600 dark:text-gray-400">Academic Programs</div>
            </div>
            <div class="text-center">
              <div class="text-2xl font-bold text-green-600 dark:text-green-400 sm:text-3xl">
                2024
              </div>
              <div class="text-sm text-gray-600 dark:text-gray-400">Latest Cutoff Data</div>
            </div>
            <div class="text-center">
              <div class="text-2xl font-bold text-orange-600 dark:text-orange-400 sm:text-3xl">
                Free
              </div>
              <div class="text-sm text-gray-600 dark:text-gray-400">No Cost, No Ads</div>
            </div>
          </div>
        </div>
      </section>
    </div>
  </div>
</Layouts.app>
